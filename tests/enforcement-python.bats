#!/usr/bin/env bats
# tests/enforcement-python.bats — Python 템플릿의 품질 수치가 실제로 막히는지 실행 결과로 판정 (로드맵 3단계).
# tests/enforcement.bats 와 같은 방식: 정본 숫자로 edge(한도 = 통과) · over(한도 + 1 = 실패) fixture 를 만들고
# 배포 템플릿 설정 그대로 실제 도구를 돌린다.
#   복잡도      — ruff C901 (python/templates/pyproject-quality.toml), ruff 는 템플릿 pre-commit rev 버전
#   함수·파일 줄 — python/templates/.pre-commit-config.yaml 의 로컬 훅을 `pre-commit run` 으로 실행 (스크립트 칸)
#   커버리지    — common/ci-templates/ci-python.yml 의 테스트 단계 run 을 그대로 실행
# 도구가 없으면 로컬에서는 skip, TEMPLATE_TOOLS_REQUIRED=1 이면 실패.

load helpers

THRESHOLDS="$REPO_ROOT/common/quality-thresholds.yaml"
PY_TPL="$REPO_ROOT/python/templates"
CI_PY="$REPO_ROOT/common/ci-templates/ci-python.yml"

setup() {
    require_tool yq
}

threshold() {
    yq -r ".thresholds.$1" "$THRESHOLDS"
}

ruff_version() {
    yq -r '.repos[] | select(.repo == "https://github.com/astral-sh/ruff-pre-commit") | .rev | sub("^v"; "")' \
        "$PY_TPL/.pre-commit-config.yaml"
}

# A fresh project: template pyproject + pre-commit config inside a git repo (pre-commit needs one); prints its path.
py_project() {
    local dir
    dir="$(mktemp -d -p "$BATS_TEST_TMPDIR")"
    mkdir -p "$dir/src/fixture" "$dir/tests"
    cp "$PY_TPL/pyproject-quality.toml" "$dir/pyproject.toml"
    cp "$PY_TPL/.pre-commit-config.yaml" "$dir/.pre-commit-config.yaml"
    : > "$dir/src/fixture/__init__.py"
    git -C "$dir" init -q
    echo "$dir"
}

ruff_rc() { # dir
    (cd "$1" && uvx --from "ruff==$(ruff_version)" ruff check --no-cache src 2>&1)
}

# Runs one local hook of the template pre-commit config on every file; returns the hook's verdict.
# Only that hook is copied (verbatim) into the config, so pre-commit does not clone the remote repos.
hook_rc() { # dir hook-id
    H="$2" yq '{"repos": [{"repo": "local", "hooks": [.repos[].hooks[] | select(.id == strenv(H))]}]}' \
        "$PY_TPL/.pre-commit-config.yaml" > "$1/.pre-commit-config.yaml"
    (cd "$1" && git add -A && PRE_COMMIT_HOME="$1/.cache/pre-commit" pre-commit run "$2" --all-files 2>&1)
}

# Cyclomatic complexity N: one function, N - 1 `if` statements.
py_complexity_fn() { # name N
    local i
    echo "def $1(x: int) -> int:"
    for i in $(seq 1 $(( $2 - 1 ))); do printf '    if x == %d:\n        x += %d\n' "$i" "$i"; done
    echo "    return x"
}

# A function spanning exactly N physical lines from `def` to its last line.
py_lines_fn() { # name N
    local i
    echo "def $1(x: int) -> int:"
    for i in $(seq 1 $(( $2 - 2 ))); do printf '    x += %d\n' "$i"; done
    echo "    return x"
}

py_file_n() { # dir N — N physical lines
    local i
    { echo '"""Generated by tests/enforcement-python.bats."""'
      for i in $(seq 2 "$2"); do echo "V$i = $i"; done; } > "$1/src/fixture/big.py"
}

# edge must pass; over must fail and print the expected marker.
py_check() { # runner(dir) edge-writer over-writer expected-over-message
    local e o out rc
    e="$(py_project)"; o="$(py_project)"
    "$2" "$e"; "$3" "$o"
    out="$("$1" "$e")" || { echo "edge rejected: $out"; return 1; }
    rc=0; out="$("$1" "$o")" || rc=$?
    [ "$rc" -ne 0 ] || { echo "over accepted (exit 0): $out"; return 1; }
    grep -qF -- "$4" <<< "$out" || { echo "over: expected [$4] in: $out"; return 1; }
}

w_complexity_edge() { py_complexity_fn edge "$(threshold complexity)" > "$1/src/fixture/c.py"; }
w_complexity_over() { py_complexity_fn over $(( $(threshold complexity) + 1 )) > "$1/src/fixture/c.py"; }
w_lines_edge() { py_lines_fn edge "$(threshold function_lines)" > "$1/src/fixture/f.py"; }
w_lines_over() { py_lines_fn over $(( $(threshold function_lines) + 1 )) > "$1/src/fixture/f.py"; }
w_file_edge() { py_file_n "$1" "$(threshold file_lines)"; }
w_file_over() { py_file_n "$1" $(( $(threshold file_lines) + 1 )); }

hook_function_length() { hook_rc "$1" function-length; }
hook_file_size() { hook_rc "$1" file-size-limit; }

@test "python: 복잡도 — 한도(정본) 함수는 ruff exit 0, 한도+1 은 C901 로 막는다" {
    require_tool uvx
    run py_check ruff_rc w_complexity_edge w_complexity_over "C901"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "python: 함수 길이 — def 부터 한도(정본) 줄 함수는 통과, 한도+1 줄은 pre-commit function-length 훅이 막는다" {
    require_tool pre-commit
    run py_check hook_function_length w_lines_edge w_lines_over "over ("
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "python: 파일 길이 — 한도(정본) 줄 파일은 통과, 한도+1 줄은 pre-commit file-size-limit 훅이 막는다" {
    require_tool pre-commit
    run py_check hook_file_size w_file_edge w_file_over "big.py"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "python: 크기 훅의 한도 숫자가 정본과 같다 (훅 이름·스크립트 상수)" {
    local cfg="$PY_TPL/.pre-commit-config.yaml" f l
    f="$(threshold function_lines)"; l="$(threshold file_lines)"
    hook_field() { H="$1" F="$2" yq -r '.repos[].hooks[] | select(.id == strenv(H)) | .[strenv(F)]' "$cfg"; }
    hook_field function-length entry | grep -Eq "^LIMIT = $f\$" || { echo "function-length hook limit is not $f"; return 1; }
    hook_field function-length name | grep -Fq "($f lines)" || { echo "function-length hook name does not say $f"; return 1; }
    hook_field file-size-limit entry | grep -Fq -- "-gt $l ]" || { echo "file-size-limit hook limit is not $l"; return 1; }
    hook_field file-size-limit name | grep -Fq "($l lines)" || { echo "file-size-limit hook name does not say $l"; return 1; }
}

# A copy of the templates with one edit applied (sed expression on one file); prints the copy's path.
broken_tpl() { # file sed-expression
    local dir
    dir="$(mktemp -d -p "$BATS_TEST_TMPDIR")"
    cp "$PY_TPL/pyproject-quality.toml" "$PY_TPL/.pre-commit-config.yaml" "$dir/"
    sed_i -e "$2" "$dir/$1"
    ! cmp -s "$PY_TPL/$1" "$dir/$1" || { echo "broken variant did not change $1: $2" >&2; return 1; }
    echo "$dir"
}

@test "python: 반증 — 고장 난 설정 5종(C90 제외 · 한도 16 · C901 ignore · 훅 한도 51 · 훅 범위 밖)에서는 위 검사가 실패한다" {
    require_tool uvx
    require_tool pre-commit
    local v
    for v in 'pyproject-quality.toml|s/^    "C90",.*$//' \
             'pyproject-quality.toml|s/^max-complexity = 15/max-complexity = 16/' \
             'pyproject-quality.toml|s/^    "PLR0915",/    "PLR0915", "C901",/' ; do
        PY_TPL="$(broken_tpl "${v%%|*}" "${v#*|}")" || return 1
        run py_check ruff_rc w_complexity_edge w_complexity_over "C901"
        [ "$status" -ne 0 ] || { echo "complexity check still passes with: $v"; return 1; }
    done
    for v in '.pre-commit-config.yaml|s/^          LIMIT = 50$/          LIMIT = 51/' \
             '.pre-commit-config.yaml|/id: function-length/,/exclude:/s|files: \^src/|files: ^lib/|' ; do
        PY_TPL="$(broken_tpl "${v%%|*}" "${v#*|}")" || return 1
        run py_check hook_function_length w_lines_edge w_lines_over "over ("
        [ "$status" -ne 0 ] || { echo "function-length check still passes with: $v"; return 1; }
    done
}

# The CI template's test step, run as-is (its own COVERAGE_THRESHOLD) on a generated package with `covered`
# of 100 one-line functions exercised by the test.
py_coverage_gate() { # covered-count
    local dir i step
    dir="$(py_project)"
    for i in $(seq 1 100); do printf 'def f%d() -> int:\n    return %d\n\n\n' "$i" "$i"; done > "$dir/src/fixture/m.py"
    { echo "from fixture.m import *  # noqa: F403"; echo; echo; echo "def test_cover() -> None:"
      for i in $(seq 1 "$1"); do echo "    f$i()  # noqa: F405"; done; } > "$dir/tests/test_m.py"
    step="$(yq -r '.jobs.test.steps[] | select(.name == "Run tests with coverage") | .run' "$CI_PY")"
    [ -n "$step" ] || { echo "coverage step not found in ci-python.yml"; return 2; }
    for v in SRC_DIR TEST_DIR COVERAGE_THRESHOLD; do
        step="${step//\$\{\{ env.$v \}\}/$(V="$v" yq -r '.env[strenv(V)]' "$CI_PY")}"
    done
    # -o pythonpath: pytest puts src/ on sys.path itself (rootdir-relative) — PYTHONPATH alone was not honored on
    # the GitHub runner's pipx pytest (PR #2 CI, cause not reproduced locally)
    (cd "$dir" && PYTHONPATH=src bash -e -c "$step -p no:cacheprovider -o pythonpath=src")
}

@test "python: 커버리지 — CI 템플릿 테스트 단계가 정본 % 는 통과시키고 정본-1 % 는 실패시킨다" {
    require_tool pytest
    pytest --help 2>/dev/null | grep -q -- '--cov-fail-under' || require_tool pytest-cov   # plugin, not a command
    local t env_t
    t="$(threshold coverage)"
    env_t="$(yq -r '.env.COVERAGE_THRESHOLD' "$CI_PY")"
    [ "$env_t" = "$t" ] || { echo "ci-python.yml COVERAGE_THRESHOLD=$env_t, ledger $t"; return 1; }
    # 100 functions, each a def line + a return line: covering k functions covers (100 + k) / 200 statements
    run py_coverage_gate $(( 2 * t - 100 ))
    [ "$status" -eq 0 ] || { echo "at threshold ($t%) rejected: $output"; return 1; }
    run py_coverage_gate $(( 2 * t - 100 - 2 ))
    [ "$status" -ne 0 ] || { echo "below threshold ($(( t - 1 ))%) accepted: $output"; return 1; }
}

@test "python: CI lint 잡이 크기 훅 두 개를 고정 버전 pre-commit 으로 실행한다" {
    local runs
    runs="$(yq -r '.jobs.lint.steps[].run // ""' "$CI_PY")"
    grep -Fq 'pre-commit==${{ env.PRE_COMMIT_VERSION }}' <<< "$runs" || { echo "pinned pre-commit install missing"; return 1; }
    grep -Fq 'pre-commit run function-length --all-files' <<< "$runs" || { echo "function-length not run in CI"; return 1; }
    grep -Fq 'pre-commit run file-size-limit --all-files' <<< "$runs" || { echo "file-size-limit not run in CI"; return 1; }
    # the step must be able to fail the job
    run yq -e '.jobs.lint.steps[] | select(.name == "Size limits (function · file)")
        | (has("if") or has("continue-on-error") or (.run | test("\\|\\| *true|; *true"))) | not' "$CI_PY"
    [ "$status" -eq 0 ] || { echo "size step can be skipped or ignored: $output"; return 1; }
}
