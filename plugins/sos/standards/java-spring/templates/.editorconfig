root = true

# ── Global defaults ──────────────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = true

# ── Java ─────────────────────────────────────────────────────────────────────
[*.java]
indent_size = 2
max_line_length = 100

# ── Gradle (Kotlin DSL) ─────────────────────────────────────────────────────
[*.{gradle,gradle.kts,kts}]
indent_size = 4

# ── Gradle (Groovy DSL) ─────────────────────────────────────────────────────
[*.gradle]
indent_size = 4

# ── XML (Spring config, checkstyle, pom.xml) ────────────────────────────────
[*.xml]
indent_size = 2

# ── Properties ───────────────────────────────────────────────────────────────
[*.properties]
indent_size = 2

# ── YAML ─────────────────────────────────────────────────────────────────────
[*.{yml,yaml}]
indent_size = 2

# ── JSON ─────────────────────────────────────────────────────────────────────
[*.json]
indent_size = 2

# ── Markdown ─────────────────────────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false

# ── Shell scripts ────────────────────────────────────────────────────────────
[*.sh]
indent_size = 4
