#!/usr/bin/env bats
# tests/enforcement-rust.bats — Rust 템플릿의 크기 수치가 실제로 막히는지 실행 결과로 판정 (로드맵 3단계).
# tests/enforcement.bats 와 같은 방식: edge(한도 = 통과) · over(한도 + 1 = 실패) fixture 를 만들고
# 배포 템플릿(rust/templates/clippy.toml + .pre-commit-config.yaml 의 로컬 훅)을 `pre-commit run` 으로 실행한다.
#   복잡도      — clippy cognitive_complexity (≈: clippy 에 순환 복잡도 린트가 없다)
#   함수 줄     — clippy too_many_lines, 한도 100 (≈: 2026-11-06 사용자 결정 — 정본 rust.function_lines.limit)
#   파일 줄     — 로컬 훅 file-size-limit (스크립트 칸)
#   커버리지    — Rust CI 템플릿이 없다 → 로드맵 3단계 A7(diff-cover) 에서
# 두 clippy 린트는 기본 꺼짐(cognitive_complexity = nursery, too_many_lines = pedantic) — 훅이 켜야 한다.

load helpers

THRESHOLDS="$REPO_ROOT/common/quality-thresholds.yaml"
RS_TPL="$REPO_ROOT/rust/templates"

setup() {
    require_tool yq
}

# The number this language must enforce: its recorded deviation (`limit`) or the standard.
limit() { # metric
    M="$1" yq -r '.languages.rust[strenv(M)].limit // .thresholds[strenv(M)]' "$THRESHOLDS"
}

require_rust_tools() {
    require_tool cargo
    require_tool pre-commit
    cargo clippy --version >/dev/null 2>&1 || require_tool cargo-clippy
}

# A fresh library crate with the template clippy.toml inside a git repo (pre-commit needs one); prints its path.
rs_crate() {
    local dir
    dir="$(mktemp -d -p "$BATS_TEST_TMPDIR")"
    printf '[package]\nname = "fixture"\nversion = "0.1.0"\nedition = "2024"\n\n[dependencies]\n' > "$dir/Cargo.toml"
    mkdir -p "$dir/src"
    cp "$RS_TPL/clippy.toml" "$dir/clippy.toml"
    git -C "$dir" init -q
    echo "$dir"
}

# Runs one local hook of the template pre-commit config (copied verbatim, nothing else) on every file.
hook_rc() { # dir hook-id
    H="$2" yq '{"repos": [{"repo": "local", "hooks": [.repos[].hooks[] | select(.id == strenv(H))]}]}' \
        "$RS_TPL/.pre-commit-config.yaml" > "$1/.pre-commit-config.yaml"
    (cd "$1" && git add -A && CARGO_TARGET_DIR="$1/target" PRE_COMMIT_HOME="$1/.cache/pre-commit" \
        pre-commit run "$2" --all-files 2>&1)
}
hook_clippy() { hook_rc "$1" cargo-clippy; }
hook_file_size() { hook_rc "$1" file-size-limit; }

# Cognitive complexity N as clippy counts it: 1 + one per `if`.
rs_complexity_fn() { # name N
    local i
    echo "pub fn $1(mut x: i64) -> i64 {"
    for i in $(seq 1 $(( $2 - 1 ))); do echo "    if x == $i { x += $i; }"; done
    echo "    x"
    echo "}"
}

# A function whose body (between the signature line and the closing brace) is N code lines.
rs_lines_fn() { # name N
    local i
    echo "pub fn $1(mut x: i64) -> i64 {"
    for i in $(seq 1 $(( $2 - 1 ))); do echo "    x += $i;"; done
    echo "    x"
    echo "}"
}

rs_file_n() { # dir N — N physical lines
    local i
    { echo "//! Generated by tests/enforcement-rust.bats."
      for i in $(seq 2 "$2"); do echo "pub const V$i: i64 = $i;"; done; } > "$1/src/lib.rs"
}

lib() { { echo "//! Generated by tests/enforcement-rust.bats."; cat; } > "$1/src/lib.rs"; }
w_complexity_edge() { rs_complexity_fn edge "$(limit complexity)" | lib "$1"; }
w_complexity_over() { rs_complexity_fn over $(( $(limit complexity) + 1 )) | lib "$1"; }
w_lines_edge() { rs_lines_fn edge "$(limit function_lines)" | lib "$1"; }
w_lines_over() { rs_lines_fn over $(( $(limit function_lines) + 1 )) | lib "$1"; }
w_file_edge() { rs_file_n "$1" "$(limit file_lines)"; }
w_file_over() { rs_file_n "$1" $(( $(limit file_lines) + 1 )); }

# edge must pass; over must fail and print the expected marker.
rs_check() { # runner(dir) edge-writer over-writer expected-over-message
    local e o out rc
    e="$(rs_crate)"; o="$(rs_crate)"
    "$2" "$e"; "$3" "$o"
    out="$("$1" "$e")" || { echo "edge rejected: $out"; return 1; }
    rc=0; out="$("$1" "$o")" || rc=$?
    [ "$rc" -ne 0 ] || { echo "over accepted (exit 0): $out"; return 1; }
    grep -qF -- "$4" <<< "$out" || { echo "over: expected [$4] in: $out"; return 1; }
}

@test "rust: 복잡도 — 인지 복잡도 한도(정본) 함수는 통과, 한도+1 은 pre-commit cargo-clippy 훅이 막는다" {
    require_rust_tools
    run rs_check hook_clippy w_complexity_edge w_complexity_over "cognitive complexity of ($(( $(limit complexity) + 1 ))/"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "rust: 함수 길이 — 본문 한도(정본 limit) 줄은 통과, 한도+1 줄은 pre-commit cargo-clippy 훅이 막는다" {
    require_rust_tools
    run rs_check hook_clippy w_lines_edge w_lines_over "too many lines ($(( $(limit function_lines) + 1 ))/"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "rust: 파일 길이 — 한도(정본) 줄 파일은 통과, 한도+1 줄은 pre-commit file-size-limit 훅이 막는다" {
    require_tool pre-commit
    run rs_check hook_file_size w_file_edge w_file_over "FAIL: src/lib.rs ($(( $(limit file_lines) + 1 )) lines, max $(limit file_lines))"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "rust: clippy.toml · 훅의 한도 숫자가 정본과 같다" {
    local cfg="$RS_TPL/.pre-commit-config.yaml" l
    grep -Eq "^cognitive-complexity-threshold = $(limit complexity)\$" "$RS_TPL/clippy.toml" \
        || { echo "cognitive-complexity-threshold is not $(limit complexity)"; return 1; }
    grep -Eq "^too-many-lines-threshold = $(limit function_lines)\$" "$RS_TPL/clippy.toml" \
        || { echo "too-many-lines-threshold is not $(limit function_lines)"; return 1; }
    l="$(limit file_lines)"
    yq -r '.repos[].hooks[] | select(.id == "file-size-limit") | .entry' "$cfg" | grep -Fq -- "-gt $l ]" \
        || { echo "file-size-limit hook limit is not $l"; return 1; }
}

# A copy of the templates with one edit applied; prints the copy's path.
broken_tpl() { # file sed-expression
    local dir
    dir="$(mktemp -d -p "$BATS_TEST_TMPDIR")"
    cp "$RS_TPL/clippy.toml" "$RS_TPL/.pre-commit-config.yaml" "$dir/"
    sed_i -e "$2" "$dir/$1"
    ! cmp -s "$RS_TPL/$1" "$dir/$1" || { echo "broken variant did not change $1: $2" >&2; return 1; }
    echo "$dir"
}

@test "rust: 반증 — 고장 난 설정 4종(린트 플래그 제거 2 · 한도 +1 2)에서는 위 검사가 실패한다" {
    require_rust_tools
    local v
    for v in '.pre-commit-config.yaml|s/ -W clippy::cognitive_complexity//' \
             'clippy.toml|s/^cognitive-complexity-threshold = 15$/cognitive-complexity-threshold = 16/' ; do
        RS_TPL="$(broken_tpl "${v%%|*}" "${v#*|}")" || return 1
        run rs_check hook_clippy w_complexity_edge w_complexity_over "cognitive complexity"
        [ "$status" -ne 0 ] && grep -qF "over accepted" <<< "$output" || { echo "complexity check not broken the expected way by: $v — $output"; return 1; }
    done
    for v in '.pre-commit-config.yaml|s/ -W clippy::too_many_lines//' \
             'clippy.toml|s/^too-many-lines-threshold = 100$/too-many-lines-threshold = 101/' ; do
        RS_TPL="$(broken_tpl "${v%%|*}" "${v#*|}")" || return 1
        run rs_check hook_clippy w_lines_edge w_lines_over "too many lines"
        [ "$status" -ne 0 ] && grep -qF "over accepted" <<< "$output" || { echo "function-length check not broken the expected way by: $v — $output"; return 1; }
    done
}
