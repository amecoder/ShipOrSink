#!/usr/bin/env bats
# tests/enforcement-kotlin.bats — Kotlin 템플릿의 크기 수치가 실제로 막히는지 실행 결과로 판정 (로드맵 3단계).
# tests/enforcement.bats 와 같은 방식: edge(한도 = 통과) · over(한도 + 1 = 실패) fixture 를 만들고
# 배포 템플릿 kotlin-spring/templates/detekt.yml 을 그대로 detekt 에 넘긴다.
#   복잡도 · 함수 길이 — detekt CyclomaticComplexMethod · LongMethod (✓). detekt 2.0 은 allowedComplexity · allowedLines 를
#     "넘으면" 보고한다 — 그래서 템플릿 값은 정본과 같다(1.23 의 threshold 는 정본 + 1 이었다)
#   파일 길이 — pre-commit 로컬 훅 file-size-limit, 한도 600 (정본 kotlin.file_lines.limit — detekt 에 파일 줄 규칙 없음)
#   커버리지 — JaCoCo 규칙은 Gradle 안 → 로드맵 3단계 A7(diff-cover) 에서
# Gradle detekt 플러그인은 buildUponDefaultConfig = false 로 detekt.yml 만 쓴다 — 여기서는 libs-quality.versions.toml
# 의 detekt 버전과 같은 단독 실행 jar(detekt-cli-<v>-all.jar)를 `--config detekt.yml` 만으로 실행한다(동치).
# CI 는 ci.yml 이 핀·sha256 으로 받아 DETEKT_JAR 로 넘긴다. 로컬: ~/.cache/dev-standards-tools/detekt-cli-<v>-all.jar
# detekt 2.0.0-alpha.6(사용자 결정 2026-11-12 — 정식 1.23.8 은 Gradle 을 JDK 25 로 돌리면 실패)은 JDK 25 에서 돈다.
# DETEKT_JAVA 로 다른 java 를 줄 수 있다.

load helpers

THRESHOLDS="$REPO_ROOT/common/quality-thresholds.yaml"
KT_TPL="$REPO_ROOT/kotlin-spring/templates"

setup() {
    require_tool yq
}

limit() { # metric
    M="$1" yq -r '.languages.kotlin[strenv(M)].limit // .thresholds[strenv(M)]' "$THRESHOLDS"
}

# The detekt version the Gradle template runs (libs-quality.versions.toml [versions] detekt = "…").
tool_version() {
    sed -nE 's/^detekt[[:space:]]*=[[:space:]]*"([^"]+)"$/\1/p' "$REPO_ROOT/kotlin-spring/templates/libs-quality.versions.toml"
}

detekt_jar() {
    echo "${DETEKT_JAR:-$HOME/.cache/dev-standards-tools/detekt-cli-$(tool_version)-all.jar}"
}

detekt_java() {
    echo "${DETEKT_JAVA:-java}"
}

# Like require_tool, for the jar: skip locally, fail in CI (TEMPLATE_TOOLS_REQUIRED=1).
require_detekt() {
    [ -n "$(tool_version)" ] || { echo "detekt version not found in libs-quality.versions.toml" >&2; return 1; }
    require_tool "$(detekt_java)"
    [ -f "$(detekt_jar)" ] && return 0
    if [ "${TEMPLATE_TOOLS_REQUIRED:-0}" = "1" ]; then
        echo "required tool missing: $(detekt_jar)" >&2
        return 1
    fi
    skip "detekt jar not found: $(detekt_jar)"
}

# Runs the template detekt.yml (whole config — every rule set, config validation on) on the fixture's sources.
dk_run() { # dir
    (cd "$1" && "$(detekt_java)" -jar "$(detekt_jar)" --config "$KT_TPL/detekt.yml" --input src/main/kotlin 2>&1)
}

kt_dir() {
    local dir
    dir="$(mktemp -d -p "$BATS_TEST_TMPDIR")"
    mkdir -p "$dir/src/main/kotlin/fx"
    git -C "$dir" init -q   # the file-size hook runs through pre-commit, which needs a repository
    echo "$dir"
}

kt_file() { # dir — stdin becomes the body of src/main/kotlin/fx/Fixture.kt
    { printf 'package fx\n\n/**\n * Generated by tests/enforcement-kotlin.bats.\n */\n'; cat; } > "$1/src/main/kotlin/fx/Fixture.kt"
}

# Cyclomatic complexity N as detekt counts it: 1 + one per `if` (no literals — MagicNumber stays quiet).
kt_complexity_fn() { # name N
    local i
    printf 'fun %s(x: Int, a: Int): Int {\n    var y = x\n' "$1"
    for i in $(seq 1 $(( $2 - 1 ))); do printf '    if (y > a) {\n        y -= a\n    }\n'; done
    printf '    return y\n}\n'
}

# A function of N counted lines: the line holding the opening `{` through the closing `}`. The signature is
# wrapped so three of its lines come before the `{` line — they must not count — and one blank plus one
# comment-only line are added on top, which detekt does not count either.
kt_lines_fn() { # name N
    local i
    printf 'fun %s(\n    x: Int,\n    a: Int,\n): Int {\n    var y = x\n\n    // not counted\n' "$1"
    for i in $(seq 1 $(( $2 - 4 ))); do printf '    y += a\n'; done
    printf '    return y\n}\n'
}

# A file of N physical lines (comment padding).
kt_file_n() { # dir N
    local i
    { printf 'package fx\n\n'
      for i in $(seq 1 $(( $2 - 2 ))); do printf '// line %d\n' "$i"; done; } > "$1/src/main/kotlin/fx/Fixture.kt"
}

w_complexity_edge() { kt_complexity_fn edge "$(limit complexity)" | kt_file "$1"; }
w_complexity_over() { kt_complexity_fn over $(( $(limit complexity) + 1 )) | kt_file "$1"; }
w_lines_edge() { kt_lines_fn edge "$(limit function_lines)" | kt_file "$1"; }
w_lines_over() { kt_lines_fn over $(( $(limit function_lines) + 1 )) | kt_file "$1"; }
w_file_edge() { kt_file_n "$1" "$(limit file_lines)"; }
w_file_over() { kt_file_n "$1" $(( $(limit file_lines) + 1 )); }

# Runs the template pre-commit file-size-limit hook (copied verbatim, nothing else) on every file.
hook_file_size() { # dir
    yq '{"repos": [{"repo": "local", "hooks": [.repos[].hooks[] | select(.id == "file-size-limit")]}]}' \
        "$KT_TPL/.pre-commit-config.yaml" > "$1/.pre-commit-config.yaml"
    (cd "$1" && git add -A && PRE_COMMIT_HOME="$1/.cache/pre-commit" pre-commit run file-size-limit --all-files 2>&1)
}

# edge must pass (exit 0); over must fail and print the expected marker.
kt_check() { # runner(dir) edge-writer over-writer expected-over-message
    local e o out rc
    e="$(kt_dir)"; o="$(kt_dir)"
    "$2" "$e"; "$3" "$o"
    out="$("$1" "$e")" || { echo "edge rejected: $out"; return 1; }
    rc=0; out="$("$1" "$o")" || rc=$?
    [ "$rc" -ne 0 ] || { echo "over accepted (exit 0): $out"; return 1; }
    grep -qF -- "$4" <<< "$out" || { echo "over: expected [$4] in: $out"; return 1; }
}

@test "kotlin: 복잡도 — 순환 복잡도 한도(정본) 함수는 템플릿 detekt 를 통과, 한도+1 은 막힌다" {
    require_detekt
    run kt_check dk_run w_complexity_edge w_complexity_over \
        "CyclomaticComplexMethod - [The function over"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "kotlin: 함수 길이 — { 줄부터 한도(정본) 줄은 시그니처 앞줄·빈 줄·주석 줄이 더 있어도 통과, 한도+1 줄은 막힌다" {
    require_detekt
    run kt_check dk_run w_lines_edge w_lines_over "LongMethod - [The function over"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "kotlin: 파일 길이 — 한도(정본 limit) 줄 파일은 통과, 한도+1 줄은 pre-commit file-size-limit 훅이 막는다" {
    require_tool pre-commit
    run kt_check hook_file_size w_file_edge w_file_over \
        "FAIL: src/main/kotlin/fx/Fixture.kt ($(( $(limit file_lines) + 1 )) lines, max $(limit file_lines))"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "kotlin: 검사에 쓴 jar 가 템플릿 detekt 버전과 같고, CI 핀도 그 버전이다" {
    require_detekt
    local v
    v="$(tool_version)"
    "$(detekt_java)" -jar "$(detekt_jar)" --version 2>/dev/null | grep -qxF "$v" \
        || { echo "jar is not detekt $v"; return 1; }
    yq -r '.env.DETEKT_VERSION' "$PROJECT_ROOT/.github/workflows/ci.yml" | grep -qxF "$v" \
        || { echo "ci.yml DETEKT_VERSION is not the template detekt version $v"; return 1; }
}

@test "kotlin: detekt.yml 한도가 정본과 같고, 훅 한도가 정본과 같고, Gradle·CI 가 위반을 실패로 연결한다" {
    local d="$KT_TPL/detekt.yml" g="$KT_TPL/quality.gradle.kts" pat
    [ "$(yq -r '.complexity.CyclomaticComplexMethod.allowedComplexity' "$d")" = "$(limit complexity)" ] \
        || { echo "CyclomaticComplexMethod.allowedComplexity is not $(limit complexity)"; return 1; }
    [ "$(yq -r '.complexity.LongMethod.allowedLines' "$d")" = "$(limit function_lines)" ] \
        || { echo "LongMethod.allowedLines is not $(limit function_lines)"; return 1; }
    ! grep -qE 'failOnSeverity[[:space:]]*=.*Never' "$g" || { echo "quality.gradle.kts sets failOnSeverity = Never"; return 1; }
    [ "$(yq -r '.config.validation' "$d")" = "true" ] || { echo "config.validation is not true"; return 1; }
    yq -r '.repos[].hooks[] | select(.id == "file-size-limit") | .entry' "$KT_TPL/.pre-commit-config.yaml" \
        | grep -Fq -- "-gt $(limit file_lines) ]" || { echo "file-size-limit hook limit is not $(limit file_lines)"; return 1; }
    for pat in 'config.setFrom(files("$rootDir/detekt.yml"))' 'buildUponDefaultConfig = false'; do
        grep -qF -- "$pat" "$g" || { echo "quality.gradle.kts lost: $pat"; return 1; }
    done
    ! grep -qE 'ignoreFailures[[:space:]]*=[[:space:]]*true' "$g" || { echo "quality.gradle.kts sets ignoreFailures = true"; return 1; }
    yq -e '.jobs[].steps[] | select(.run | test("^\\./gradlew detektMain detektTest( |$)")) | select(has("if") or has("continue-on-error") | not)' \
        "$REPO_ROOT/common/ci-templates/ci-kotlin.yml" >/dev/null || { echo "ci-kotlin.yml has no unconditional ./gradlew detektMain detektTest step"; return 1; }
    for pat in '"detektMain",' '"detektTest",'; do
        grep -qF -- "$pat" "$g" || { echo "quality.gradle.kts check does not depend on $pat"; return 1; }
    done
}

@test "kotlin: 장부 — 복잡도·함수 ✓, 파일 script(limit 600), 커버리지 script(coverage-gate)" {
    local m c
    for m in complexity function_lines; do
        c="$(M="$m" yq -r '.languages.kotlin[strenv(M)].cell' "$THRESHOLDS")"
        [ "$c" = "✓" ] || { echo "kotlin.$m cell is [$c], expected ✓"; return 1; }
    done
    [ "$(yq -r '.languages.kotlin.file_lines.cell' "$THRESHOLDS")" = "script" ] || { echo "kotlin.file_lines cell is not script"; return 1; }
    [ "$(limit file_lines)" = "600" ] || { echo "kotlin.file_lines.limit is not 600"; return 1; }
    [ "$(yq -r '.languages.kotlin.coverage.cell' "$THRESHOLDS")" = "script" ] || { echo "kotlin.coverage cell is not script"; return 1; }
}

# A copy of detekt.yml with one edit applied; prints the copy's directory.
broken_tpl() { # sed-expression
    local dir
    dir="$(mktemp -d -p "$BATS_TEST_TMPDIR")"
    cp "$KT_TPL/detekt.yml" "$dir/"
    sed_i -e "$1" "$dir/detekt.yml"
    ! cmp -s "$KT_TPL/detekt.yml" "$dir/detekt.yml" || { echo "broken variant did not change detekt.yml: $1" >&2; return 1; }
    echo "$dir"
}

@test "kotlin: 반증 — 고장 난 설정 5종(한도 정본-1 2 · 정본+1 2 · 없는 규칙 키 1)에서는 위 검사가 실패한다" {
    require_detekt
    local v sed_expr w why c l
    c="$(limit complexity)"; l="$(limit function_lines)"
    for v in "/CyclomaticComplexMethod:/,/allowedComplexity/s/allowedComplexity: $c /allowedComplexity: $(( c - 1 )) /|w_complexity_edge w_complexity_over|CyclomaticComplexMethod - [The function edge" \
             "/CyclomaticComplexMethod:/,/allowedComplexity/s/allowedComplexity: $c /allowedComplexity: $(( c + 1 )) /|w_complexity_edge w_complexity_over|over accepted" \
             "/LongMethod:/,/allowedLines/s/allowedLines: $l /allowedLines: $(( l - 1 )) /|w_lines_edge w_lines_over|LongMethod - [The function edge" \
             "/LongMethod:/,/allowedLines/s/allowedLines: $l /allowedLines: $(( l + 1 )) /|w_lines_edge w_lines_over|over accepted" \
             "s/^  LongMethod:\$/  NoSuchRuleForTest:\n    active: true\n\n  LongMethod:/|w_lines_edge w_lines_over|is misspelled or does not exist"; do
        IFS='|' read -r sed_expr w why <<< "$v"
        KT_TPL="$(broken_tpl "$sed_expr")" || return 1
        # shellcheck disable=SC2086 # w holds two writer names
        run kt_check dk_run $w "_"
        # threshold - 1 and the unknown key must break the edge for that reason (the rule fired / validation), not a crash
        [ "$status" -ne 0 ] && grep -qF "$why" <<< "$output" \
            || { echo "check not broken the expected way ($why) by: $sed_expr — $output"; return 1; }
        KT_TPL="$REPO_ROOT/kotlin-spring/templates"
    done
}
