#!/usr/bin/env bats
# tests/enforcement-csharp.bats — C# 템플릿의 품질 수치가 실제로 막히는지 실행 결과로 판정 (로드맵 3단계).
# tests/enforcement.bats 와 같은 방식: edge(한도 = 통과) · over(한도 + 1 = 실패) fixture 를 만들고
# csharp-dotnet/templates 의 Directory.Build.props · .editorconfig · stylecop.json · global.json · SonarLint.xml 을
# 그대로 복사한 솔루션을 `dotnet build` / 템플릿 pre-commit 훅으로 실행한다.
#   복잡도 · 함수 길이 — SonarAnalyzer S1541 · S138. 한도 숫자는 SonarLint.xml(AdditionalFiles)로만 넘어간다 —
#     없으면 Sonar 기본값 10 · 80 이 적용된다. 경고는 TreatWarningsAsErrors 로 빌드 오류가 된다
#   파일 길이 — pre-commit 로컬 훅 file-size-limit (스크립트 칸)
#   커버리지 — pre-push 훅 dotnet-test (coverlet.msbuild Threshold — `--collect` 방식은 Threshold 를 읽지 않는다)
# fixture 프로젝트 파일: tests/enforcement-csharp/ (테스트 패키지 버전은 Renovate nuget 매니저가 읽는다).
# dotnet: PATH 의 dotnet 또는 DOTNET(실행 파일 경로) — global.json 의 SDK(8.0.404, latestFeature)가 필요하다.
# 첫 실행은 nuget.org 에서 분석기·테스트 패키지를 받는다(~/.nuget/packages 캐시).

load helpers

THRESHOLDS="$REPO_ROOT/common/quality-thresholds.yaml"
CS_TPL="$REPO_ROOT/csharp-dotnet/templates"
CS_FIX="$PROJECT_ROOT/tests/enforcement-csharp"

setup() {
    require_tool yq
    export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1
    # No lingering build processes: a reused MSBuild node or the shared compiler server keeps the captured
    # stdout pipe open and `run` waits until it exits (minutes). Env vars are read as MSBuild properties.
    export MSBUILDDISABLENODEREUSE=1 DOTNET_CLI_USE_MSBUILD_SERVER=0 UseSharedCompilation=false
    # Not a vulnerability test: a new advisory on the fixture's test packages must not turn restore red
    export NuGetAudit=false
}

limit() { # metric
    M="$1" yq -r '.languages.csharp[strenv(M)].limit // .thresholds[strenv(M)]' "$THRESHOLDS"
}

dotnet_bin() { echo "${DOTNET:-dotnet}"; }

require_dotnet() {
    require_tool "$(dotnet_bin)"
    # the template global.json pins 8.0.404 with latestFeature — any 8.0.4xx and later feature band
    if ! "$(dotnet_bin)" --list-sdks 2>/dev/null | grep -Eq '^8\.0\.([4-9][0-9]{2})'; then
        [ "${TEMPLATE_TOOLS_REQUIRED:-0}" = "1" ] && { echo "required SDK missing: 8.0.4xx (global.json)" >&2; return 1; }
        skip "no .NET SDK 8.0.4xx+ for the template global.json"
    fi
    # the hook entries call plain `dotnet` — put the chosen one first on PATH
    PATH="$(dirname "$(command -v "$(dotnet_bin)")"):$PATH"
    export PATH
}

# A solution with the template files copied verbatim, plus the two fixture projects; prints its path.
cs_sln() {
    local dir f
    dir="$(mktemp -d -p "$BATS_TEST_TMPDIR")"
    for f in Directory.Build.props .editorconfig stylecop.json global.json SonarLint.xml; do
        [ -f "$CS_TPL/$f" ] && cp "$CS_TPL/$f" "$dir/"
    done
    mkdir -p "$dir/Fx" "$dir/Fx.Tests"
    cp "$CS_FIX/Fx.csproj" "$dir/Fx/"
    cp "$CS_FIX/Fx.Tests.csproj" "$dir/Fx.Tests/"
    git -C "$dir" init -q   # pre-commit needs a repository
    echo "$dir"
}

cs_build() { # dir — the library only, analyzers on, warnings as errors
    (cd "$1" && dotnet build Fx/Fx.csproj 2>&1)
}

# Runs one local hook of the template pre-commit config (copied verbatim, nothing else) on every file.
hook_rc() { # dir hook-id [stage]
    H="$2" yq '{"repos": [{"repo": "local", "hooks": [.repos[].hooks[] | select(.id == strenv(H))]}]}' \
        "$CS_TPL/.pre-commit-config.yaml" > "$1/.pre-commit-config.yaml"
    (cd "$1" && git add -A && PRE_COMMIT_HOME="$1/.cache/pre-commit" \
        pre-commit run "$2" --all-files ${3:+--hook-stage "$3"} 2>&1)
}
hook_file_size() { hook_rc "$1" file-size-limit; }
# The pre-push coverage hook runs `dotnet test --no-restore` at the repository root — give it a solution and
# restore first, as a developer's checkout would have.
hook_coverage() {
    (cd "$1" && dotnet new sln -n Fx >/dev/null 2>&1 && dotnet sln Fx.sln add Fx/Fx.csproj Fx.Tests/Fx.Tests.csproj >/dev/null 2>&1 \
        && dotnet restore Fx.sln >/dev/null 2>&1) || { echo "solution setup / restore failed"; return 1; }
    hook_rc "$1" dotnet-test pre-push
}

lib() { # dir — stdin becomes Fx/Small.cs
    cat > "$1/Fx/Small.cs"
}

doc() { # summary for a method taking (x, a)
    printf '    /// <summary>Adds.</summary>\n    /// <param name="x">Input.</param>\n    /// <param name="a">Step.</param>\n    /// <returns>Result.</returns>\n'
}

cls_open() { printf 'namespace Fx;\n\n/// <summary>Generated by tests/enforcement-csharp.bats.</summary>\npublic static class Small\n{\n'; }

# Cyclomatic complexity N as Sonar counts it: 1 + one per `?:` (one line each — S138 stays quiet).
cs_complexity_method() { # name N
    local i
    cls_open; doc
    printf '    public static int %s(int x, int a)\n    {\n        var y = x;\n' "$1"
    for i in $(seq 1 $(( $2 - 1 ))); do printf '        y = y > a ? y - a : y;\n'; done
    printf '        return y;\n    }\n}\n'
}

# A method of N counted lines: S138 counts the lines between the braces, blank and comment-only lines excluded —
# two comment lines and one blank line are added on top and must not count.
cs_lines_method() { # name N
    local i
    cls_open; doc
    printf '    public static int %s(int x, int a)\n    {\n        var y = x;\n\n        // not counted\n        // not counted\n' "$1"
    for i in $(seq 1 $(( $2 - 2 ))); do printf '        y += a;\n'; done
    printf '        return y;\n    }\n}\n'
}

# A file of N physical lines (comment padding).
cs_file_n() { # dir N
    local i
    { cls_open
      for i in $(seq 1 $(( $2 - 6 ))); do printf '    // line %d\n' "$i"; done
      printf '}\n'; } > "$1/Fx/Small.cs"
}

# 100 one-line methods in the library and a test that calls the first K of them: line coverage = K %.
cs_coverage_k() { # dir K
    local i
    { printf 'namespace Fx;\n\n/// <summary>Generated by tests/enforcement-csharp.bats.</summary>\npublic static class Cov\n{\n'
      for i in $(seq 1 100); do
          [ "$i" -eq 1 ] || printf '\n'
          printf '    /// <summary>F.</summary>\n    /// <param name="x">Input.</param>\n    /// <returns>Result.</returns>\n'
          printf '    public static int F%d(int x) => x + %d;\n' "$i" "$i"
      done
      printf '}\n'; } > "$1/Fx/Cov.cs"
    { printf 'namespace Fx.Tests;\n\npublic class CovTests\n{\n    [Xunit.Fact]\n    public void Calls()\n    {\n'
      for i in $(seq 1 "$2"); do printf '        Xunit.Assert.Equal(%d, Fx.Cov.F%d(0));\n' "$i" "$i"; done
      printf '    }\n}\n'; } > "$1/Fx.Tests/CovTests.cs"
}

w_complexity_edge() { cs_complexity_method Edge "$(limit complexity)" | lib "$1"; }
w_complexity_over() { cs_complexity_method Over $(( $(limit complexity) + 1 )) | lib "$1"; }
w_lines_edge() { cs_lines_method Edge "$(limit function_lines)" | lib "$1"; }
w_lines_over() { cs_lines_method Over $(( $(limit function_lines) + 1 )) | lib "$1"; }
w_file_edge() { cs_file_n "$1" "$(limit file_lines)"; }
w_file_over() { cs_file_n "$1" $(( $(limit file_lines) + 1 )); }
w_cov_edge() { cs_coverage_k "$1" "$(limit coverage)"; }
w_cov_over() { cs_coverage_k "$1" $(( $(limit coverage) - 1 )); }

# edge must pass (exit 0); over must fail and print the expected marker.
cs_check() { # runner(dir) edge-writer over-writer expected-over-message
    local e o out rc
    e="$(cs_sln)"; o="$(cs_sln)"
    "$2" "$e"; "$3" "$o"
    out="$("$1" "$e")" || { echo "edge rejected: $out"; return 1; }
    rc=0; out="$("$1" "$o")" || rc=$?
    [ "$rc" -ne 0 ] || { echo "over accepted (exit 0): $out"; return 1; }
    grep -qF -- "$4" <<< "$out" || { echo "over: expected [$4] in: $out"; return 1; }
}

@test "csharp: 복잡도 — 순환 복잡도 한도(정본) 메서드는 템플릿 빌드를 통과, 한도+1 은 S1541 이 막는다" {
    require_dotnet
    run cs_check cs_build w_complexity_edge w_complexity_over \
        "Cyclomatic Complexity of this method is $(( $(limit complexity) + 1 )) which is greater than $(limit complexity) authorized"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "csharp: 함수 길이 — 중괄호 안 한도(정본) 줄은 주석·빈 줄이 더 있어도 통과, 한도+1 줄은 S138 이 막는다" {
    require_dotnet
    run cs_check cs_build w_lines_edge w_lines_over \
        "has $(( $(limit function_lines) + 1 )) lines, which is greater than the $(limit function_lines) lines authorized"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "csharp: 파일 길이 — 한도(정본) 줄 파일은 통과, 한도+1 줄은 pre-commit file-size-limit 훅이 막는다" {
    require_tool pre-commit
    run cs_check hook_file_size w_file_edge w_file_over \
        "FAIL: Fx/Small.cs ($(( $(limit file_lines) + 1 )) lines, max $(limit file_lines))"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "csharp: 커버리지 — 줄 커버리지 한도(정본)%는 pre-push dotnet-test 훅을 통과, 한도-1 %는 막힌다" {
    require_dotnet
    require_tool pre-commit
    run cs_check hook_coverage w_cov_edge w_cov_over "The total line coverage is below the specified $(limit coverage)"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

# Coverage gate (roadmap stage 3 T1): main holds the projects with scripts/coverage-gate.sh (bootstrap copies it); the
# change adds Fx/Cov.cs and its test. The real dotnet-test hook writes Fx.Tests/coverage.cobertura.xml
# (-p:CoverletOutputFormat=cobertura), then the template hook coverage-gate judges the changed lines: K of 100.
gate_base() { # dir
    mkdir -p "$1/scripts"
    cp "$REPO_ROOT/common/testing-templates/coverage-gate.sh" "$1/scripts/"
    printf 'bin/\nobj/\n.cache/\ncoverage.cobertura.xml\n' > "$1/.gitignore"
    git -C "$1" add -A && git -C "$1" -c user.email=t@t -c user.name=t commit -qm base
    git -C "$1" update-ref refs/remotes/origin/main HEAD
}
w_gate_edge() { gate_base "$1"; w_cov_edge "$1"; }
w_gate_over() { gate_base "$1"; w_cov_over "$1"; }
hook_coverage_gate() {
    hook_coverage "$1" >/dev/null   # below the total threshold the hook fails — coverlet still writes the report first
    [ -f "$1/Fx.Tests/coverage.cobertura.xml" ] || { echo "dotnet-test wrote no Fx.Tests/coverage.cobertura.xml"; return 1; }
    hook_rc "$1" coverage-gate pre-push
}

@test "csharp: 커버리지 게이트 — dotnet-test 훅이 쓴 Cobertura 로 coverage-gate 훅이 바뀐 줄 한도(정본)%는 통과, 한도-1 %는 막는다" {
    require_dotnet
    require_tool pre-commit
    command -v uvx >/dev/null 2>&1 || require_tool pipx
    run cs_check hook_coverage_gate w_gate_edge w_gate_over "FAIL: changed-line coverage is below $(limit coverage)%"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "csharp: 한도 숫자가 정본과 같고, 빌드·훅이 위반을 실패로 연결한다" {
    local s="$CS_TPL/SonarLint.xml" p="$CS_TPL/Directory.Build.props" e="$CS_TPL/.editorconfig" c="$CS_TPL/.pre-commit-config.yaml" ent
    [ -f "$s" ] || { echo "SonarLint.xml missing — Sonar defaults (10 · 80) apply"; return 1; }
    [ "$(yq -p xml -r '.AnalysisInput.Rules.Rule[] | select(.Key == "S1541") | .Parameters.Parameter | select(.Key == "maximumFunctionComplexityThreshold") | .Value' "$s")" = "$(limit complexity)" ] \
        || { echo "SonarLint.xml S1541 maximumFunctionComplexityThreshold is not $(limit complexity)"; return 1; }
    [ "$(yq -p xml -r '.AnalysisInput.Rules.Rule[] | select(.Key == "S138") | .Parameters.Parameter | select(.Key == "max") | .Value' "$s")" = "$(limit function_lines)" ] \
        || { echo "SonarLint.xml S138 max is not $(limit function_lines)"; return 1; }
    grep -qF '<AdditionalFiles Include="$(MSBuildThisFileDirectory)SonarLint.xml"' "$p" || { echo "Directory.Build.props does not pass SonarLint.xml"; return 1; }
    grep -qF '<TreatWarningsAsErrors>true</TreatWarningsAsErrors>' "$p" || { echo "TreatWarningsAsErrors is not true"; return 1; }
    grep -Eq '^dotnet_diagnostic\.S1541\.severity = (warning|error)' "$e" || { echo "S1541 is not warning/error"; return 1; }
    grep -Eq '^dotnet_diagnostic\.S138\.severity = (warning|error)' "$e" || { echo "S138 is not warning/error"; return 1; }
    yq -r '.repos[].hooks[] | select(.id == "file-size-limit") | .entry' "$c" | grep -Fq -- "-gt $(limit file_lines) ]" \
        || { echo "file-size-limit hook limit is not $(limit file_lines)"; return 1; }
    ent="$(yq -r '.repos[].hooks[] | select(.id == "dotnet-test") | .entry' "$c")"
    for pat in "-p:CollectCoverage=true" "-p:Threshold=$(limit coverage)" "-p:ThresholdType=line" "-p:ThresholdStat=total"; do
        grep -qF -- "$pat" <<< "$ent" || { echo "dotnet-test hook lost: $pat"; return 1; }
    done
}

@test "csharp: 장부 — 복잡도·함수·커버리지 ✓, 파일 script" {
    local m c
    for m in complexity function_lines coverage; do
        c="$(M="$m" yq -r '.languages.csharp[strenv(M)].cell' "$THRESHOLDS")"
        [ "$c" = "✓" ] || { echo "csharp.$m cell is [$c], expected ✓"; return 1; }
    done
    [ "$(yq -r '.languages.csharp.file_lines.cell' "$THRESHOLDS")" = "script" ] || { echo "csharp.file_lines cell is not script"; return 1; }
}

# A copy of the templates with one edit applied; prints the copy's path.
broken_tpl() { # file sed-expression
    local dir
    dir="$(mktemp -d -p "$BATS_TEST_TMPDIR")"
    cp -a "$CS_TPL/." "$dir/"
    sed_i -e "$2" "$dir/$1"
    ! cmp -s "$CS_TPL/$1" "$dir/$1" || { echo "broken variant did not change $1: $2" >&2; return 1; }
    echo "$dir"
}

@test "csharp: 반증 — 고장 난 설정 6종(SonarLint.xml 없음 2 · 한도 +1 2 · severity none · --collect 커버리지)에서는 위 검사가 실패한다" {
    require_dotnet
    require_tool pre-commit
    local v file sed_expr runner w why dir
    for v in "SonarLint.xml|DELETE|cs_build|w_complexity_edge w_complexity_over|S1541" \
             "SonarLint.xml|DELETE|cs_build|w_lines_edge w_lines_over|over accepted" \
             "SonarLint.xml|s#<Value>$(limit complexity)</Value>#<Value>$(( $(limit complexity) + 1 ))</Value>#|cs_build|w_complexity_edge w_complexity_over|over accepted" \
             "SonarLint.xml|s#<Value>$(limit function_lines)</Value>#<Value>$(( $(limit function_lines) + 1 ))</Value>#|cs_build|w_lines_edge w_lines_over|over accepted" \
             ".editorconfig|s/^dotnet_diagnostic.S138.severity = warning/dotnet_diagnostic.S138.severity = none/|cs_build|w_lines_edge w_lines_over|over accepted" \
             ".pre-commit-config.yaml|s/-p:CollectCoverage=true /--collect:\"XPlat Code Coverage\" /|hook_coverage|w_cov_edge w_cov_over|over accepted"; do
        IFS='|' read -r file sed_expr runner w why <<< "$v"
        if [ "$sed_expr" = "DELETE" ]; then
            dir="$(mktemp -d -p "$BATS_TEST_TMPDIR")"; cp -a "$CS_TPL/." "$dir/"; rm "$dir/$file"
        else
            dir="$(broken_tpl "$file" "$sed_expr")" || return 1
        fi
        CS_TPL="$dir"
        # shellcheck disable=SC2086 # w holds two writer names
        run cs_check "$runner" $w "_"
        [ "$status" -ne 0 ] && grep -qF "$why" <<< "$output" \
            || { echo "check not broken the expected way ($why) by: $file $sed_expr — $output"; return 1; }
        CS_TPL="$REPO_ROOT/csharp-dotnet/templates"
    done
}
