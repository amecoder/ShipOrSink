<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusion filter.
  Add patterns here to suppress false positives.
  Reference: https://spotbugs.readthedocs.io/en/stable/filter.html
-->
<FindBugsFilter>
    <!-- Exclude generated code -->
    <Match>
        <Source name="~.*generated.*"/>
    </Match>

    <!-- Exclude Spring Boot application class -->
    <Match>
        <Class name="~.*Application"/>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    </Match>

    <!-- Exclude DTO / entity equals/hashCode (managed by Lombok or IDE) -->
    <Match>
        <Or>
            <Package name="~.*\.dto"/>
            <Package name="~.*\.entity"/>
        </Or>
        <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS"/>
    </Match>

    <!-- Exclude test code from high-confidence checks -->
    <Match>
        <Source name="~.*Test\.java"/>
        <Or>
            <Bug pattern="URF_UNREAD_FIELD"/>
            <Bug pattern="DLS_DEAD_LOCAL_STORE"/>
        </Or>
    </Match>
</FindBugsFilter>
