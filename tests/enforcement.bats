#!/usr/bin/env bats
# tests/enforcement.bats — 문서의 품질 수치가 "실제로 막히는지"를 실행 결과로 판정한다 (로드맵 1단계 A1).
# 정본 common/quality-thresholds.yaml 의 숫자로 fixture 를 만든다:
#   edge = 정확히 한도 → exit 0 이어야 한다 · over = 한도 + 1 → exit 1 + 그 linter 의 지적이어야 한다
# 배포 템플릿 설정 그대로 버전 고정한 실제 도구를 돌린다. 값 비교가 아니라 "막는가"(종료 코드)를 본다.
# 도구가 없으면 로컬에서는 skip, CI(TEMPLATE_TOOLS_REQUIRED=1)에서는 실패.

load helpers

THRESHOLDS="$REPO_ROOT/common/quality-thresholds.yaml"
GO_CFG="$REPO_ROOT/go/templates/.golangci.yml"
CI_GO="$REPO_ROOT/common/ci-templates/ci-go.yml"

setup() {
    require_tool yq
}

threshold() {
    yq -r ".thresholds.$1" "$THRESHOLDS"
}

require_go_tools() {
    require_tool golangci-lint
    require_tool go
}

# A fresh Go module with the given golangci config; prints its path.
go_module() {
    local dir
    dir="$(mktemp -d -p "$BATS_TEST_TMPDIR")"
    printf 'module example.com/fixture\n\ngo 1.24\n' > "$dir/go.mod"
    cp "$1" "$dir/.golangci.yml"
    printf '// Package fixture is generated by tests/enforcement.bats.\npackage fixture\n' > "$dir/doc.go"
    echo "$dir"
}

# The config itself must enable the linter: `run --enable-only` below would otherwise mask a removed linter.
linter_enabled() { # dir linter
    (cd "$1" && GOLANGCI_LINT_CACHE="$1/.cache/lint" golangci-lint linters 2>&1) \
        | awk '/^Enabled by your configuration/{on=1; next} /^Disabled by your configuration/{on=0} on' \
        | grep -q "^$2:"
}

# Runs golangci-lint with the module's config, limited to one linter; returns golangci-lint's exit status.
# The config's own run.issues-exit-code still applies, so "reports but exits 0" is caught by the caller.
golangci_rc() { # dir linter
    (cd "$1" && GOLANGCI_LINT_CACHE="$1/.cache/lint" GOCACHE="$1/.cache/go" GOFLAGS=-mod=mod \
        golangci-lint run --enable-only "$2" ./... 2>&1)
}

# edge module must exit 0; over module must exit 1 and print the expected message.
go_check() { # cfg linter edge-file-writer over-file-writer expected-over-message
    local cfg="$1" linter="$2" e o out rc
    e="$(go_module "$cfg")"; o="$(go_module "$cfg")"
    "$3" "$e"; "$4" "$o"
    linter_enabled "$e" "$linter" || { echo "$linter is not enabled by the template config"; return 1; }
    out="$(golangci_rc "$e" "$linter")" || { echo "edge rejected: $out"; return 1; }
    rc=0; out="$(golangci_rc "$o" "$linter")" || rc=$?
    [ "$rc" -eq 1 ] || { echo "over exit $rc (want 1): $out"; return 1; }
    grep -qF -- "$5" <<< "$out" || { echo "over: expected [$5] in: $out"; return 1; }
}

# func NAME with cyclomatic complexity N (1 + N-1 if statements)
gen_complexity_fn() {
    local i
    echo "// $1 has cyclomatic complexity $2."
    echo "func $1(x int) int {"
    for i in $(seq 1 $(( $2 - 1 ))); do echo "	if x == $i {"; echo "		x++"; echo "	}"; done
    echo "	return x"
    echo "}"
}

# func NAME whose body is exactly N lines, built from two-line statements so funlen.statements (40) is not hit first:
# odd N = (N-1)/2 pairs + return · even N = (N-2)/2 pairs + x++ + return
gen_body_fn() {
    local i pairs
    pairs=$(( ($2 - 1) / 2 ))
    echo "// $1 has a $2-line body."
    echo "func $1(x int) int {"
    for i in $(seq 1 "$pairs"); do echo "	x = add(x,"; echo "		$i)"; done
    if [ $(( $2 % 2 )) -eq 0 ]; then echo "	x++"; fi
    echo "	return x"
    echo "}"
}

write_complexity_edge() { { echo "package fixture"; echo; gen_complexity_fn edge "$(threshold complexity)"; } > "$1/c.go"; }
write_complexity_over() { { echo "package fixture"; echo; gen_complexity_fn over $(( $(threshold complexity) + 1 )); } > "$1/c.go"; }
write_lines_edge() { { echo "package fixture"; echo; echo "func add(a, b int) int { return a + b }"; echo; gen_body_fn edge "$(threshold function_lines)"; } > "$1/f.go"; }
write_lines_over() { { echo "package fixture"; echo; echo "func add(a, b int) int { return a + b }"; echo; gen_body_fn over $(( $(threshold function_lines) + 1 )); } > "$1/f.go"; }
write_file_n() { # dir lines
    local i
    { echo "package fixture"; for i in $(seq 2 "$2"); do echo "// line $i"; done; } > "$1/long.go"
}
write_file_edge() { write_file_n "$1" "$(threshold file_lines)"; }
write_file_over() { write_file_n "$1" $(( $(threshold file_lines) + 1 )); }

@test "go: 복잡도 — 한도(정본) 함수는 exit 0, 한도+1 은 golangci-lint 가 exit 1 로 막는다" {
    require_go_tools
    local t; t="$(threshold complexity)"
    run go_check "$GO_CFG" gocyclo write_complexity_edge write_complexity_over "cyclomatic complexity $(( t + 1 )) of func \`over\`"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "go: 함수 길이 — 본문 한도(정본) 줄은 exit 0, 한도+1 줄은 funlen 이 exit 1 로 막는다" {
    require_go_tools
    local t; t="$(threshold function_lines)"
    run go_check "$GO_CFG" funlen write_lines_edge write_lines_over "Function 'over' is too long ($(( t + 1 )) > $t)"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "go: 파일 길이 — 한도(정본) 줄 파일은 exit 0, 한도+1 줄은 revive file-length-limit 이 exit 1 로 막는다" {
    require_go_tools
    local t; t="$(threshold file_lines)"
    run go_check "$GO_CFG" revive write_file_edge write_file_over "file length is $(( t + 1 )) lines, which exceeds the limit of $t"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

# Counter-tests: each broken variant of the template must make the checks above fail.
broken_variant() { # name yq-expression
    local f="$BATS_TEST_TMPDIR/$1.yml"
    yq "$2" "$GO_CFG" > "$f"
    echo "$f"
}

@test "go: 반증 — 고장 난 설정 4종(v1 키 · linter 제거 · issues-exit-code 0 · default none)에서는 위 검사가 실패한다" {
    require_go_tools
    local name expr cfg survived=""
    while IFS='|' read -r name expr; do
        cfg="$(broken_variant "$name" "$expr")"
        if go_check "$cfg" gocyclo write_complexity_edge write_complexity_over "of func \`over\`" >/dev/null 2>&1; then
            survived="$survived $name"
        fi
    done <<'EOF'
v1-keys|.["linters-settings"] = .linters.settings | del(.linters.settings)
gocyclo-removed|.linters.enable |= map(select(. != "gocyclo"))
issues-exit-code-0|.run["issues-exit-code"] = 0
default-none|.linters.default = "none" | .linters.enable = ["errcheck"]
EOF
    [ -z "$survived" ] || { echo "broken config still passed the check:$survived"; return 1; }
}

# The CI template's coverage step, run as-is (with its own COVERAGE_THRESHOLD) on a generated module.
# One function is named totalPrice: `go tool cover -func` prints it, and a loose `grep total` would match it.
go_coverage_gate() { # covered-percent
    local t="$1" dir step env_t i
    dir="$(go_module "$GO_CFG")"
    { echo "package fixture"; echo "func totalPrice() int { return 0 }"
      for i in $(seq 2 100); do echo "func F$i() int { return $i }"; done; } > "$dir/f.go"
    { echo "package fixture"; echo 'import "testing"'; echo "func TestCover(t *testing.T) {"
      echo "	_ = totalPrice()"; for i in $(seq 2 "$t"); do echo "	_ = F$i()"; done; echo "}"; } > "$dir/f_test.go"
    (cd "$dir" && GOCACHE="$dir/.cache/go" go test -coverprofile=coverage.out ./... >/dev/null 2>&1) || { echo "go test failed"; return 2; }
    env_t="$(yq -r '.["env"].COVERAGE_THRESHOLD' "$CI_GO")"
    step="$(yq -r '.jobs[].steps[] | select(.name == "Check coverage threshold") | .run' "$CI_GO")"
    [ -n "$step" ] || { echo "coverage step not found in ci-go.yml"; return 2; }
    step="${step//\$\{\{ env.COVERAGE_THRESHOLD \}\}/$env_t}"
    (cd "$dir" && GOCACHE="$dir/.cache/go" bash -e -c "$step")   # GitHub's default shell is bash -e {0}
}

@test "go: 커버리지 — CI 템플릿 판정 단계가 정본 % 는 통과시키고 정본-1 % 는 실패시킨다" {
    require_tool go
    local t
    t="$(threshold coverage)"
    run go_coverage_gate "$t"
    [ "$status" -eq 0 ] || { echo "at threshold ($t%) rejected: $output"; return 1; }
    run go_coverage_gate $(( t - 1 ))
    [ "$status" -eq 1 ] || { echo "below threshold ($(( t - 1 ))%) not rejected (status $status): $output"; return 1; }
}

@test "go: 커버리지 — 판정 단계가 무력화돼 있지 않다 (continue-on-error · if 없음)" {
    run yq -e '.jobs[].steps[] | select(.name == "Check coverage threshold") | (has("continue-on-error") or has("if")) | not' "$CI_GO"
    [ "$status" -eq 0 ] || { echo "coverage step can be skipped or ignored: $output"; return 1; }
}

# ── TypeScript ───────────────────────────────────────────────────────────────
# Tools come from tests/enforcement-ts/package-lock.json installed outside the repo (npm ci into TS_TOOLS_DIR).
# Fixture projects live in $BATS_TEST_TMPDIR (cleaned by bats) with node_modules symlinked to the tools.
TS_TPL="$REPO_ROOT/typescript-react/templates"
TS_PINS="$TS_TPL/dev-dependencies.txt"

require_ts_tools() {
    require_tool jq
    if [ -n "${TS_TOOLS_DIR:-}" ] && [ -x "$TS_TOOLS_DIR/node_modules/.bin/eslint" ] && [ -x "$TS_TOOLS_DIR/node_modules/.bin/vitest" ]; then
        return 0
    fi
    if [ "${TEMPLATE_TOOLS_REQUIRED:-0}" = "1" ]; then
        echo "TS_TOOLS_DIR with eslint/vitest missing (npm ci tests/enforcement-ts into it)" >&2
        return 1
    fi
    skip "TS_TOOLS_DIR not set up (cp tests/enforcement-ts/package*.json \$TS_TOOLS_DIR && npm ci --prefix \$TS_TOOLS_DIR)"
}

# A Next.js-shaped project with the template configs. A plain .js file is always present:
# type-aware rules used to crash `eslint .` on one ("requires type information").
ts_project() { # eslint-config-path
    local d
    d="$(mktemp -d -p "$BATS_TEST_TMPDIR" fx.XXXXXX)"
    mkdir -p "$d/src" "$d/tests"
    ln -s "$TS_TOOLS_DIR/node_modules" "$d/node_modules"
    cp "$1" "$d/eslint.config.mjs"
    cp "$TS_TPL/vitest.config.ts" "$d/"
    echo "import '@testing-library/jest-dom/vitest';" > "$d/tests/setup.ts"   # what bootstrap.sh writes
    printf '{\n  "compilerOptions": {"strict": true, "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "noEmit": true, "jsx": "react-jsx", "types": ["vitest/globals"]},\n  "include": ["src", "tests"]\n}\n' > "$d/tsconfig.json"
    printf 'export const answer = 42;\n' > "$d/src/plain.js"
    echo "$d"
}

# Same command as ci-typescript.yml "ESLint check" (eslint .); returns ESLint's exit status (0 ok · 1 errors · 2 crash).
eslint_rc() { (cd "$1" && "$TS_TOOLS_DIR/node_modules/.bin/eslint" . 2>&1); }

ts_check() { # cfg edge-writer over-writer expected-message
    local e o out rc
    e="$(ts_project "$1")"; o="$(ts_project "$1")"
    "$2" "$e"; "$3" "$o"
    out="$(eslint_rc "$e")" || { echo "edge rejected: $out"; return 1; }
    rc=0; out="$(eslint_rc "$o")" || rc=$?
    [ "$rc" -eq 1 ] || { echo "over exit $rc (want 1): $out"; return 1; }
    grep -qF -- "$4" <<< "$out" || { echo "over: expected [$4] in: $out"; return 1; }
}

ts_complexity_fn() { # name N
    local i
    echo "export function $1(x: number): number {"
    for i in $(seq 1 $(( $2 - 1 ))); do echo "  if (x === $i) {"; echo "    x += 1;"; echo "  }"; done
    echo "  return x;"
    echo "}"
}
# function spanning exactly N lines, signature and closing brace included (how max-lines-per-function counts)
ts_lines_fn() { # name N
    local i
    echo "export function $1(x: number): number {"
    for i in $(seq 1 $(( $2 - 3 ))); do echo "  x += $i;"; done
    echo "  return x;"
    echo "}"
}
ts_file_n() { # dir N — N non-blank, non-comment lines
    local i
    { echo "export const v1 = 1;"; for i in $(seq 2 "$2"); do echo "export const v$i = $i;"; done; } > "$1/src/a.ts"
}
ts_write_complexity_edge() { ts_complexity_fn edge "$(threshold complexity)" > "$1/src/a.ts"; }
ts_write_complexity_over() { ts_complexity_fn over $(( $(threshold complexity) + 1 )) > "$1/src/a.ts"; }
ts_write_lines_edge() { ts_lines_fn edge "$(threshold function_lines)" > "$1/src/a.ts"; }
ts_write_lines_over() { ts_lines_fn over $(( $(threshold function_lines) + 1 )) > "$1/src/a.ts"; }
ts_write_file_edge() { ts_file_n "$1" "$(threshold file_lines)"; }
ts_write_file_over() { ts_file_n "$1" $(( $(threshold file_lines) + 1 )); }

@test "ts: 복잡도 — 한도(정본) 함수는 eslint exit 0, 한도+1 은 exit 1 로 막는다" {
    require_ts_tools
    local t; t="$(threshold complexity)"
    run ts_check "$TS_TPL/eslint.config.mjs" ts_write_complexity_edge ts_write_complexity_over "has a complexity of $(( t + 1 )). Maximum allowed is $t"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "ts: 함수 길이 — 시그니처 포함 한도(정본) 줄 함수는 exit 0, 한도+1 줄은 exit 1 로 막는다" {
    require_ts_tools
    local t; t="$(threshold function_lines)"
    run ts_check "$TS_TPL/eslint.config.mjs" ts_write_lines_edge ts_write_lines_over "has too many lines ($(( t + 1 ))). Maximum allowed is $t"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "ts: 파일 길이 — 한도(정본) 줄 파일은 exit 0, 한도+1 줄은 exit 1 로 막는다" {
    require_ts_tools
    local t; t="$(threshold file_lines)"
    run ts_check "$TS_TPL/eslint.config.mjs" ts_write_file_edge ts_write_file_over "File has too many lines ($(( t + 1 ))). Maximum allowed is $t"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

# Root *.cjs config files: eslint-config-next registers jsx-a11y only for js/jsx/mjs/ts/tsx/mts/cts —
# rules applied to every file used to abort `eslint .` with exit 2 on any .cjs (found with A12, 2026-11-13).
@test "ts: 루트의 .cjs 설정 파일(.dependency-cruiser.cjs 등)이 있어도 eslint . 가 통과한다 (설정 오류 exit 2 · module no-undef 없음)" {
    require_ts_tools
    local d
    d="$(ts_project "$TS_TPL/eslint.config.mjs")"
    cp "$TS_TPL/.dependency-cruiser.cjs" "$d/"
    printf 'module.exports = { plugins: [] };\n' > "$d/.babelrc.cjs"
    run eslint_rc "$d"
    [ "$status" -eq 0 ] || { echo "eslint . failed with a root .cjs file (status $status): $output"; return 1; }
}

# Structure: the effective config (what ESLint actually resolved) has the three rules at error with the ledger
# numbers for .ts AND .tsx source files — a later block that relaxes *.tsx would not show up in the .ts fixtures.
@test "ts: 구조 — .ts · .tsx · .js · .jsx · app/ 소스 파일의 유효 설정에서 세 규칙이 error 이고 한도가 정본과 같다" {
    require_ts_tools
    local d f cfg bad=""
    d="$(ts_project "$TS_TPL/eslint.config.mjs")"
    for f in src/x.ts src/x.tsx src/x.js src/x.jsx app/x.tsx; do
        cfg="$(cd "$d" && "$TS_TOOLS_DIR/node_modules/.bin/eslint" --print-config "$f")"
        jq -e --argjson c "$(threshold complexity)" --argjson fl "$(threshold function_lines)" --argjson ml "$(threshold file_lines)" '
            .rules.complexity == [2, {max: $c}]
            and .rules["max-lines-per-function"][0] == 2 and .rules["max-lines-per-function"][1].max == $fl
            and .rules["max-lines"][0] == 2 and .rules["max-lines"][1].max == $ml' <<< "$cfg" >/dev/null \
            || bad="$bad $f:$(jq -c '[.rules.complexity, .rules["max-lines-per-function"], .rules["max-lines"]]' <<< "$cfg")"
    done
    [ -z "$bad" ] || { echo "not enforced as the ledger says:$bad"; return 1; }
}

@test "ts: 반증 — warn · off · *.tsx 면제로 고친 설정에서는 위 검사가 실패한다" {
    require_ts_tools
    local name cfg survived="" tsx_off
    tsx_off='  { files: ["**/*.tsx"], rules: { complexity: "off", "max-lines-per-function": "off", "max-lines": "off" } },'
    for name in complexity-warn complexity-off tsx-exempt; do
        cfg="$BATS_TEST_TMPDIR/$name.mjs"
        case "$name" in
            complexity-warn) sed -E 's/complexity: \["error"/complexity: ["warn"/' "$TS_TPL/eslint.config.mjs" > "$cfg" ;;
            complexity-off)  sed -E 's/complexity: \["error"/complexity: ["off"/' "$TS_TPL/eslint.config.mjs" > "$cfg" ;;
            tsx-exempt)      awk -v l="$tsx_off" '/^  prettierConfig,/{print l} {print}' "$TS_TPL/eslint.config.mjs" > "$cfg" ;;
        esac
        ! cmp -s "$cfg" "$TS_TPL/eslint.config.mjs" || { echo "variant $name did not change the config"; return 1; }
        if ts_check "$cfg" ts_write_complexity_edge ts_write_complexity_over "has a complexity of" >/dev/null 2>&1 \
            && bats_struct_ok "$cfg"; then
            survived="$survived $name"
        fi
    done
    [ -z "$survived" ] || { echo "broken config still passed the checks:$survived"; return 1; }
}

# structure check as a function (for the counter-test): 0 only if .ts and .tsx both enforce complexity at error
bats_struct_ok() { # cfg
    local d f
    d="$(ts_project "$1")"
    for f in src/x.ts src/x.tsx; do
        (cd "$d" && "$TS_TOOLS_DIR/node_modules/.bin/eslint" --print-config "$f") | jq -e '.rules.complexity[0] == 2' >/dev/null || return 1
    done
}

# 100 functions with one branch each; the test calls the first k with both arguments, so lines · functions ·
# statements · branches are all exactly k%. A second, never-imported file checks that untested modules count.
ts_coverage_rc() { # k [untested-file]
    local d i
    d="$(ts_project "$TS_TPL/eslint.config.mjs")"
    { for i in $(seq 1 100); do
        echo "export function f$i(b: boolean): number {"; echo "  if (b) {"; echo "    return $i;"; echo "  }"; echo "  return 0;"; echo "}"
      done; } > "$d/src/f.ts"
    { echo "import * as m from '../src/f';"; echo "test('cover', () => {"
      for i in $(seq 1 "$1"); do echo "  expect(m.f$i(true)).toBe($i);"; echo "  expect(m.f$i(false)).toBe(0);"; done; echo "});"; } > "$d/tests/f.test.ts"
    if [ "${2:-}" = untested ]; then   # a .tsx under app/ — a narrowed include (e.g. src/**/*.ts) would miss it
        mkdir -p "$d/app"
        { for i in $(seq 1 100); do echo "export function g$i(): number {"; echo "  return $i;"; echo "}"; done; } > "$d/app/untested.tsx"
    fi
    (cd "$d" && "$TS_TOOLS_DIR/node_modules/.bin/vitest" run --coverage 2>&1)
}

@test "ts: 커버리지 — 정본 % 는 통과, 정본-1 % 는 네 지표(줄·함수·문장·분기) 모두에서 실패한다" {
    require_ts_tools
    local t m missing=""
    t="$(threshold coverage)"
    run ts_coverage_rc "$t"
    [ "$status" -eq 0 ] || { echo "at threshold ($t%) rejected: $output"; return 1; }
    run ts_coverage_rc $(( t - 1 ))
    [ "$status" -eq 1 ] || { echo "below threshold not rejected (status $status): $output"; return 1; }
    for m in lines functions statements branches; do
        grep -qF "Coverage for $m ($(( t - 1 ))%) does not meet global threshold ($t%)" <<< "$output" || missing="$missing $m"
    done
    [ -z "$missing" ] || { echo "metric not enforced:$missing — $output"; return 1; }
}

@test "ts: 커버리지 — 테스트가 import 하지 않은 파일도 분모에 들어간다 (coverage.include)" {
    require_ts_tools
    run ts_coverage_rc 100 untested
    [ "$status" -eq 1 ] || { echo "an untested module did not lower coverage (status $status): $output"; return 1; }
    grep -q "does not meet global threshold" <<< "$output" || { echo "failed for another reason: $output"; return 1; }
}

@test "ts: bootstrap 이 설치하는 고정 버전과 enforcement 가 검증하는 버전이 같다" {
    require_tool jq
    # every pin is name@x.y.z (exact), optionally tagged `tailwind` or `if-missing`
    run grep -vnE '^(#|$)|^(@[a-z0-9-]+/)?[a-z0-9.-]+@[0-9]+\.[0-9]+\.[0-9]+( tailwind| if-missing)?$' "$TS_PINS"
    [ "$status" -eq 1 ] || { echo "malformed or non-exact pin: $output"; return 1; }
    # verified set = every non-tailwind pin, plus next/react/react-dom (app deps a Next.js project already has)
    run diff <(grep -vE '^#|^$| tailwind$' "$TS_PINS" | sed -E 's/ if-missing$//; s/^(.+)@([^@]+)$/\1 \2/' | sort) \
             <(jq -r '.devDependencies | del(.next, .react, .["react-dom"]) | to_entries[] | "\(.key) \(.value)"' "$PROJECT_ROOT/tests/enforcement-ts/package.json" | sort)
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "ts: README 의 수동 설치 명령이 npm 에 name@x.y.z 인자만 넘긴다 (태그가 패키지 이름으로 새지 않는다)" {
    local readme="$REPO_ROOT/typescript-react/README.md" cmds line args bad="" n=0
    cmds="$(grep -E '^grep .*dev-dependencies\.txt"? .*\| xargs npm install' "$readme")"
    [ -n "$cmds" ] || { echo "manual install command not found in README"; return 1; }
    while IFS= read -r line; do
        line="${line/xargs npm install -D -E/xargs printf '%s\\n'}"
        args="$(SOS_STANDARDS="$REPO_ROOT" bash -c "$line")"
        n=$(( n + $(grep -c . <<< "$args") ))
        bad="$bad$(grep -vE '^(@[a-z0-9-]+/)?[a-z0-9.-]+@[0-9]+\.[0-9]+\.[0-9]+$' <<< "$args" || true)"
    done <<< "$cmds"
    [ -z "$bad" ] || { echo "non-package arguments passed to npm: $bad"; return 1; }
    [ "$n" -eq "$(grep -cvE '^#|^$| tailwind$' "$REPO_ROOT/typescript-react/templates/dev-dependencies.txt")" ] || { echo "README installs $n packages"; return 1; }
}

@test "ts: CI 의 enforcement 용 Node 버전이 TypeScript CI 템플릿 NODE_VERSION 과 같다" {
    local ci_node tpl_node
    [ "$(yq -r '.jobs.bats.steps[] | select(.uses // "" | test("actions/setup-node@")) | .with["node-version"]' "$PROJECT_ROOT/.github/workflows/ci.yml")" = '${{ env.NODE_VERSION }}' ] \
        || { echo "bats setup-node does not take NODE_VERSION from the workflow env"; return 1; }
    ci_node="$(yq -r '.["env"].NODE_VERSION' "$PROJECT_ROOT/.github/workflows/ci.yml")"
    tpl_node="$(yq -r '.["env"].NODE_VERSION' "$REPO_ROOT/common/ci-templates/ci-typescript.yml")"
    [ -n "$ci_node" ] && [ "$ci_node" = "$tpl_node" ] || { echo "ci.yml bats setup-node [$ci_node] != ci-typescript NODE_VERSION [$tpl_node]"; return 1; }
}
