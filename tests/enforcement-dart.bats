#!/usr/bin/env bats
# tests/enforcement-dart.bats — Flutter/Dart 템플릿의 품질 수치가 실제로 막히는지 실행 결과로 판정 (로드맵 3단계).
# tests/enforcement.bats 와 같은 방식: edge(한도 = 통과) · over(한도 + 1, 커버리지는 한도 - 1 = 실패) fixture 를 만들고
# flutter-dart/templates 의 pre-commit 로컬 훅을 `pre-commit run` 으로 그대로 실행한다.
#   dart analyze 에는 복잡도·함수 길이 규칙이 없다 — 템플릿 tool/quality_metrics(독립 패키지, package:analyzer)가
#   훅 dart-metrics 로 막는다. 커버리지는 훅 flutter-test 가 `flutter test --coverage` 뒤에 coverage_check.dart 로 막는다
#   파일 길이 — 훅 file-size-limit. 네 칸 모두 "script" (도구에 한도 기능이 없어 스크립트가 막는다)
# flutter 는 여기서 실행하지 않는다: PATH 앞에 둔 가짜 flutter 가 정해진 커버리지의 coverage/lcov.info 만 쓴다 —
#   훅 명령(flutter test --coverage && coverage_check …)은 그대로 돌고, lcov 생성만 Flutter 몫으로 남는다.
# dart: PATH 의 dart 또는 DART(실행 파일 경로). 첫 실행은 pub.dev 에서 analyzer 를 받는다(~/.pub-cache).

load helpers

THRESHOLDS="$REPO_ROOT/common/quality-thresholds.yaml"
DART_TPL="$REPO_ROOT/flutter-dart/templates"

setup() {
    require_tool yq
}

limit() { # metric
    M="$1" yq -r '.languages.dart[strenv(M)].limit // .thresholds[strenv(M)]' "$THRESHOLDS"
}

require_dart() {
    require_tool "${DART:-dart}"
    require_tool pre-commit
    # the hook entries call plain `dart` — put the chosen one first on PATH
    PATH="$(dirname "$(command -v "${DART:-dart}")"):$PATH"
    export PATH
}

# A project with the template tool/quality_metrics copied verbatim, inside a git repo; prints its path.
dart_proj() {
    local dir
    dir="$(mktemp -d -p "$BATS_TEST_TMPDIR")"
    mkdir -p "$dir/lib" "$dir/tool"
    cp -R "$DART_TPL/tool/quality_metrics" "$dir/tool/"
    git -C "$dir" init -q
    echo "$dir"
}

# Runs one local hook of the template pre-commit config (copied verbatim, nothing else) on every file.
hook_rc() { # dir hook-id [stage]
    H="$2" yq '{"repos": [{"repo": "local", "hooks": [.repos[].hooks[] | select(.id == strenv(H))]}]}' \
        "$DART_TPL/.pre-commit-config.yaml" > "$1/.pre-commit-config.yaml"
    (cd "$1" && git add -A && PRE_COMMIT_HOME="$1/.cache/pre-commit" \
        pre-commit run "$2" --all-files ${3:+--hook-stage "$3"} 2>&1)
}
hook_metrics() { hook_rc "$1" dart-metrics; }
hook_file_size() { hook_rc "$1" file-size-limit; }
hook_coverage() { (PATH="$1/.fakebin:$PATH" hook_rc "$1" flutter-test pre-push); }

lib() { cat > "$1/lib/fixture.dart"; }

# Cyclomatic complexity N: 1 + N-1 one-line statements, each adding exactly one branch, cycling through nine kinds
# (if · ?: · && · || · ?? · for · while · catch · case) so every counter is exercised and the length limit stays quiet.
DART_BRANCHES=(
    '  if (y > a) y -= a;'
    '  y = y > a ? y - a : y;'
    '  ok = ok && y > a;'
    '  ok = ok || y < a;'
    '  z = z ?? y;'
    '  for (var i = 0; i < a; i++) { y++; }'
    '  while (y > a * 10) { y--; }'
    '  try { y++; } on Exception { y--; }'
    '  switch (y) { case 0: y++; }'
)
dart_complexity_fn() { # name N
    local i
    printf 'int %s(int x, int a) {\n  var y = x;\n  var ok = true;\n  int? z;\n' "$1"
    for i in $(seq 0 $(( $2 - 2 ))); do printf '%s\n' "${DART_BRANCHES[$(( i % ${#DART_BRANCHES[@]} ))]}"; done
    printf '  return y;\n}\n'
}

# A function of N physical lines from its declaration to its closing brace. A doc comment and an annotation
# above it must not count; one blank and one comment line inside do count (physical lines).
dart_lines_fn() { # name N
    local i
    printf "/// Doc comment — not counted.\n@pragma('vm:prefer-inline')\n"
    printf 'int %s(int x, int a) {\n  var y = x;\n\n  // counted\n' "$1"
    for i in $(seq 1 $(( $2 - 6 ))); do printf '  y += a;\n'; done
    printf '  return y;\n}\n'
}

dart_file_n() { # dir N — N physical lines
    local i
    { printf '// Generated by tests/enforcement-dart.bats.\n'
      for i in $(seq 2 "$2"); do printf 'const int v%d = %d;\n' "$i" "$i"; done; } > "$1/lib/fixture.dart"
}

# A fake flutter whose `flutter test --coverage` writes coverage/lcov.info with K of 100 lines hit.
fake_flutter() { # dir K
    mkdir -p "$1/.fakebin"
    printf '#!/usr/bin/env bash\nmkdir -p coverage\nprintf "SF:lib/fixture.dart\\nLF:100\\nLH:%s\\nend_of_record\\n" > coverage/lcov.info\n' "$2" \
        > "$1/.fakebin/flutter"
    chmod +x "$1/.fakebin/flutter"
}

w_complexity_edge() { dart_complexity_fn edge "$(limit complexity)" | lib "$1"; }
w_complexity_over() { dart_complexity_fn over $(( $(limit complexity) + 1 )) | lib "$1"; }
w_lines_edge() { dart_lines_fn edge "$(limit function_lines)" | lib "$1"; }
w_lines_over() { dart_lines_fn over $(( $(limit function_lines) + 1 )) | lib "$1"; }
w_file_edge() { dart_file_n "$1" "$(limit file_lines)"; }
w_file_over() { dart_file_n "$1" $(( $(limit file_lines) + 1 )); }
w_cov_edge() { fake_flutter "$1" "$(limit coverage)"; }
w_cov_over() { fake_flutter "$1" $(( $(limit coverage) - 1 )); }

# edge must pass (exit 0); over must fail and print the expected marker.
dart_check() { # runner(dir) edge-writer over-writer expected-over-message
    local e o out rc
    e="$(dart_proj)"; o="$(dart_proj)"
    "$2" "$e"; "$3" "$o"
    out="$("$1" "$e")" || { echo "edge rejected: $out"; return 1; }
    rc=0; out="$("$1" "$o")" || rc=$?
    [ "$rc" -ne 0 ] || { echo "over accepted (exit 0): $out"; return 1; }
    grep -qF -- "$4" <<< "$out" || { echo "over: expected [$4] in: $out"; return 1; }
}

@test "dart: 복잡도 — 순환 복잡도 한도(정본) 함수는 훅 dart-metrics 를 통과, 한도+1 은 막힌다" {
    require_dart
    run dart_check hook_metrics w_complexity_edge w_complexity_over \
        "FAIL: lib/fixture.dart:1 over (complexity $(( $(limit complexity) + 1 )), max $(limit complexity))"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "dart: 함수 길이 — 선언~} 한도(정본) 줄은 문서 주석·어노테이션이 더 있어도 통과, 한도+1 줄은 막힌다" {
    require_dart
    run dart_check hook_metrics w_lines_edge w_lines_over \
        "FAIL: lib/fixture.dart:3 over ($(( $(limit function_lines) + 1 )) lines, max $(limit function_lines))"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "dart: 파일 길이 — 한도(정본) 줄 파일은 통과, 한도+1 줄은 pre-commit file-size-limit 훅이 막는다" {
    require_tool pre-commit
    run dart_check hook_file_size w_file_edge w_file_over \
        "FAIL: lib/fixture.dart ($(( $(limit file_lines) + 1 )) lines, max $(limit file_lines))"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "dart: 커버리지 — 줄 커버리지 한도(정본)%는 pre-push flutter-test 훅을 통과, 한도-1 %는 막힌다" {
    require_dart
    run dart_check hook_coverage w_cov_edge w_cov_over \
        "FAIL: line coverage $(( $(limit coverage) - 1 )).00% ($(( $(limit coverage) - 1 ))/100), min $(limit coverage)%"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "dart: 훅의 한도 숫자가 정본과 같고, 도구 패키지가 고정돼 있고, 프로젝트 분석에서 빠져 있다" {
    local c="$DART_TPL/.pre-commit-config.yaml" ent
    ent="$(yq -r '.repos[].hooks[] | select(.id == "dart-metrics") | .entry' "$c")"
    grep -qF -- "--max-complexity $(limit complexity) --max-lines $(limit function_lines)" <<< "$ent" \
        || { echo "dart-metrics hook limits are not $(limit complexity) / $(limit function_lines)"; return 1; }
    yq -r '.repos[].hooks[] | select(.id == "flutter-test") | .entry' "$c" \
        | grep -qF "coverage_check.dart coverage/lcov.info $(limit coverage)" \
        || { echo "flutter-test hook does not check coverage $(limit coverage)"; return 1; }
    yq -r '.repos[].hooks[] | select(.id == "file-size-limit") | .entry' "$c" | grep -Fq -- "-gt $(limit file_lines) ]" \
        || { echo "file-size-limit hook limit is not $(limit file_lines)"; return 1; }
    yq -e '.dependencies.analyzer | test("^[0-9]+\\.[0-9]+\\.[0-9]+$")' "$DART_TPL/tool/quality_metrics/pubspec.yaml" >/dev/null \
        || { echo "tool/quality_metrics analyzer is not an exact version"; return 1; }
    [ -f "$DART_TPL/tool/quality_metrics/pubspec.lock" ] || { echo "tool/quality_metrics/pubspec.lock missing"; return 1; }
    yq -e '.analyzer.exclude[] | select(. == "tool/quality_metrics/**")' "$DART_TPL/analysis_options.yaml" >/dev/null \
        || { echo "analysis_options.yaml does not exclude tool/quality_metrics"; return 1; }
}

@test "dart: 장부 — 네 칸 모두 script" {
    local m c
    for m in complexity function_lines file_lines coverage; do
        c="$(M="$m" yq -r '.languages.dart[strenv(M)].cell' "$THRESHOLDS")"
        [ "$c" = "script" ] || { echo "dart.$m cell is [$c], expected script"; return 1; }
    done
}

# A copy of the templates with one edit applied; prints the copy's path.
broken_tpl() { # file sed-expression
    local dir
    dir="$(mktemp -d -p "$BATS_TEST_TMPDIR")"
    cp -a "$DART_TPL/." "$dir/"
    sed_i -e "$2" "$dir/$1"
    ! cmp -s "$DART_TPL/$1" "$dir/$1" || { echo "broken variant did not change $1: $2" >&2; return 1; }
    echo "$dir"
}

@test "dart: 반증 — 고장 난 설정 7종(훅 한도 +1 2 · 커버리지 한도 -1 · 커버리지 검사 제거 · 분기 집계 고장 3)에서는 위 검사가 실패한다" {
    require_dart
    local v file sed_expr runner w c l k
    c="$(limit complexity)"; l="$(limit function_lines)"; k="$(limit coverage)"
    for v in ".pre-commit-config.yaml|s/--max-complexity $c /--max-complexity $(( c + 1 )) /|hook_metrics|w_complexity_edge w_complexity_over" \
             ".pre-commit-config.yaml|s/--max-lines $l /--max-lines $(( l + 1 )) /|hook_metrics|w_lines_edge w_lines_over" \
             ".pre-commit-config.yaml|s#coverage/lcov.info $k'#coverage/lcov.info $(( k - 1 ))'#|hook_coverage|w_cov_edge w_cov_over" \
             ".pre-commit-config.yaml|s#flutter test --coverage \&\&#flutter test --coverage; exit 0;#|hook_coverage|w_cov_edge w_cov_over" \
             "tool/quality_metrics/bin/quality_metrics.dart|/void _branch/,/}/s/count++;//|hook_metrics|w_complexity_edge w_complexity_over" \
             "tool/quality_metrics/bin/quality_metrics.dart|s/{'&&', /{/|hook_metrics|w_complexity_edge w_complexity_over" \
             "tool/quality_metrics/bin/quality_metrics.dart|s/void visitCatchClause(CatchClause node) => _branch(node);/void visitCatchClause(CatchClause node) => node.visitChildren(this);/|hook_metrics|w_complexity_edge w_complexity_over"; do
        IFS='|' read -r file sed_expr runner w <<< "$v"
        DART_TPL="$(broken_tpl "$file" "$sed_expr")" || return 1
        # shellcheck disable=SC2086 # w holds two writer names
        run dart_check "$runner" $w "_"
        [ "$status" -ne 0 ] && grep -qF "over accepted" <<< "$output" \
            || { echo "check not broken the expected way (over accepted) by: $file $sed_expr — $output"; return 1; }
        DART_TPL="$REPO_ROOT/flutter-dart/templates"
    done
}
