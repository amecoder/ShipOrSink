#!/usr/bin/env bats
# tests/enforcement-ruby.bats — Ruby/Rails 템플릿의 품질 수치가 실제로 막히는지 실행 결과로 판정 (로드맵 3단계).
# tests/enforcement.bats 와 같은 방식: edge(한도 = 통과) · over(한도 + 1, 커버리지는 한도 미만 = 실패) fixture 를 만들고
# ruby-rails/templates 의 .rubocop.yml · .simplecov 와 pre-commit 로컬 훅(rubocop · rspec · file-size-limit)을 그대로 실행한다.
#   복잡도 · 메서드 길이 — RuboCop Metrics/CyclomaticComplexity · MethodLength. 상속하는 rubocop-rails-omakase 가
#     Metrics 부서를 통째로 끄므로 `Enabled: true` 가 있어야 한다
#   파일 길이 — 훅 file-size-limit (RuboCop 에 파일 줄 규칙이 없다)
#   커버리지 — 훅 rspec(pre-push)이 spec_helper 의 `require "simplecov"` 로 .simplecov 의 minimum_coverage 를 건다
# 젬: tests/enforcement-ruby/Gemfile(.lock) — bootstrap 이 안내하는 젬을 정확한 버전으로. 첫 실행은 rubygems.org 에서 받는다.
# ruby(3.3 이상 — simplecov 1.3 의 조건) · bundle: PATH 또는 RUBY_BIN(디렉터리). BUNDLE_PATH 를 주면 그곳에 설치한다(CI).

load helpers

THRESHOLDS="$REPO_ROOT/common/quality-thresholds.yaml"
RB_TPL="$REPO_ROOT/ruby-rails/templates"
RB_FIX="$PROJECT_ROOT/tests/enforcement-ruby"

setup() {
    require_tool yq
    [ -z "${RUBY_BIN:-}" ] || { PATH="$RUBY_BIN:$PATH"; export PATH; }
    export BUNDLE_GEMFILE="$RB_FIX/Gemfile" BUNDLE_FROZEN=true
}

limit() { # metric
    M="$1" yq -r '.languages.ruby[strenv(M)].limit // .thresholds[strenv(M)]' "$THRESHOLDS"
}

require_ruby() {
    require_tool ruby
    require_tool bundle
    require_tool pre-commit
    bundle check >/dev/null 2>&1 || bundle install --quiet >/dev/null 2>&1 \
        || { echo "bundle install failed for $BUNDLE_GEMFILE" >&2; return 1; }
}

# A project with the template .rubocop.yml / .simplecov copied verbatim, inside a git repo; prints its path.
rb_proj() {
    local dir
    dir="$(mktemp -d -p "$BATS_TEST_TMPDIR")"
    mkdir -p "$dir/app/models" "$dir/spec"
    cp "$RB_TPL/.rubocop.yml" "$RB_TPL/.simplecov" "$dir/"
    git -C "$dir" init -q
    echo "$dir"
}

# Runs one local hook of the template pre-commit config (copied verbatim, nothing else) on every file.
hook_rc() { # dir hook-id [stage]
    H="$2" yq '{"repos": [{"repo": "local", "hooks": [.repos[].hooks[] | select(.id == strenv(H))]}]}' \
        "$RB_TPL/.pre-commit-config.yaml" > "$1/.pre-commit-config.yaml"
    (cd "$1" && git add -A && PRE_COMMIT_HOME="$1/.cache/pre-commit" \
        pre-commit run "$2" --all-files ${3:+--hook-stage "$3"} 2>&1)
}
hook_rubocop() { hook_rc "$1" rubocop; }
hook_file_size() { hook_rc "$1" file-size-limit; }
hook_rspec() { hook_rc "$1" rspec pre-push; }

model() { # dir — stdin becomes app/models/fixture.rb
    { printf '# frozen_string_literal: true\n\n# Generated by tests/enforcement-ruby.bats.\nclass Fixture\n'; cat; printf 'end\n'; } \
        > "$1/app/models/fixture.rb"
}

# Cyclomatic complexity N as RuboCop counts it: 1 + one per `if` modifier. A bare `if result` (no comparison) keeps
# Metrics/AbcSize under its 30 — a comparison would add a second condition point per line.
rb_complexity_method() { # name N
    local i
    printf '  def %s(value, step)\n    result = value\n' "$1"
    for i in $(seq 1 $(( $2 - 1 ))); do printf '    result -= step if result\n'; done
    printf '    result\n  end\n'
}

# A method whose body (between def and end) has N code lines; one blank and one comment line are added on top.
# The filler lines only read a variable, so Metrics/AbcSize stays quiet.
rb_lines_method() { # name N
    local i
    printf '  def %s(value, step)\n    result = value + step\n\n    # not counted\n' "$1"
    for i in $(seq 1 $(( $2 - 2 ))); do printf '    result\n'; done
    printf '    result\n  end\n'
}

rb_file_n() { # dir N — N physical lines
    local i
    { printf '# frozen_string_literal: true\n'
      for i in $(seq 2 "$2"); do printf '# line %d\n' "$i"; done; } > "$1/app/models/fixture.rb"
}

# 99 two-line methods; the def line runs at load, the body line only when called. With the class line and one
# constant line (both run at load) SimpleCov sees 200 relevant lines, 101 of them covered without any call.
# The spec calls K methods: line coverage = (101 + K) / 200 — K = 2t - 101 gives exactly t %, one less t - 0.5 %.
rb_coverage_k() { # dir K
    local i
    { printf '# frozen_string_literal: true\n\n# Generated by tests/enforcement-ruby.bats.\nclass Cov\n'
      printf '  VERSION = 1\n'
      for i in $(seq 1 99); do printf '  def self.f%d(value)\n    value + %d\n  end\n' "$i" "$i"; done
      printf 'end\n'; } > "$1/app/models/cov.rb"
    printf '# frozen_string_literal: true\n\nrequire "simplecov"   # loads the template .simplecov (minimum_coverage)\nSimpleCov.start\n' > "$1/spec/spec_helper.rb"
    { printf '# frozen_string_literal: true\n\nrequire_relative "spec_helper"\nrequire_relative "../app/models/cov"\n\nRSpec.describe Cov do\n  it "calls" do\n'
      for i in $(seq 1 "$2"); do printf '    expect(described_class.f%d(0)).to eq(%d)\n' "$i" "$i"; done
      printf '  end\nend\n'; } > "$1/spec/cov_spec.rb"
}

w_complexity_edge() { rb_complexity_method edge "$(limit complexity)" | model "$1"; }
w_complexity_over() { rb_complexity_method over $(( $(limit complexity) + 1 )) | model "$1"; }
w_lines_edge() { rb_lines_method edge "$(limit function_lines)" | model "$1"; }
w_lines_over() { rb_lines_method over $(( $(limit function_lines) + 1 )) | model "$1"; }
w_file_edge() { rb_file_n "$1" "$(limit file_lines)"; }
w_file_over() { rb_file_n "$1" $(( $(limit file_lines) + 1 )); }
w_cov_edge() { rb_coverage_k "$1" $(( 2 * $(limit coverage) - 101 )); }
w_cov_over() { rb_coverage_k "$1" $(( 2 * $(limit coverage) - 102 )); }

# edge must pass (exit 0); over must fail and print the expected marker.
rb_check() { # runner(dir) edge-writer over-writer expected-over-message
    local e o out rc
    e="$(rb_proj)"; o="$(rb_proj)"
    "$2" "$e"; "$3" "$o"
    out="$("$1" "$e")" || { echo "edge rejected: $out"; return 1; }
    rc=0; out="$("$1" "$o")" || rc=$?
    [ "$rc" -ne 0 ] || { echo "over accepted (exit 0): $out"; return 1; }
    grep -qF -- "$4" <<< "$out" || { echo "over: expected [$4] in: $out"; return 1; }
}

@test "ruby: 복잡도 — 순환 복잡도 한도(정본) 메서드는 훅 rubocop 을 통과, 한도+1 은 막힌다" {
    require_ruby
    run rb_check hook_rubocop w_complexity_edge w_complexity_over \
        "Metrics/CyclomaticComplexity: Cyclomatic complexity for over is too high. [$(( $(limit complexity) + 1 ))/$(limit complexity)]"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "ruby: 메서드 길이 — def~end 사이 한도(정본) 줄은 빈 줄·주석이 더 있어도 통과, 한도+1 줄은 막힌다" {
    require_ruby
    run rb_check hook_rubocop w_lines_edge w_lines_over \
        "Metrics/MethodLength: Method has too many lines. [$(( $(limit function_lines) + 1 ))/$(limit function_lines)]"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "ruby: rubocop 훅은 .rubocop.yml 의 Exclude(db/schema.rb 등)를 지킨다 — 위반이 있어도 건드리지 않는다" {
    require_ruby
    local d out
    d="$(rb_proj)"
    mkdir -p "$d/db"
    printf 'ActiveRecord::Schema.define(version: 1) do\nend\n' > "$d/db/schema.rb"   # no frozen_string_literal
    cp "$d/db/schema.rb" "$d/schema.orig"
    out="$(hook_rubocop "$d")" || { echo "excluded file failed the hook: $out"; return 1; }
    cmp -s "$d/db/schema.rb" "$d/schema.orig" || { echo "--autocorrect rewrote an excluded file"; return 1; }
}

@test "ruby: 파일 길이 — 한도(정본) 줄 파일은 통과, 한도+1 줄은 pre-commit file-size-limit 훅이 막는다" {
    require_tool pre-commit
    run rb_check hook_file_size w_file_edge w_file_over \
        "FAIL: app/models/fixture.rb ($(( $(limit file_lines) + 1 )) lines, max $(limit file_lines))"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "ruby: 커버리지 — 줄 커버리지 한도(정본)%는 pre-push rspec 훅을 통과, 한도 미만은 SimpleCov 가 막는다" {
    require_ruby
    run rb_check hook_rspec w_cov_edge w_cov_over \
        "Line coverage ($(( $(limit coverage) - 1 )).50%) is below the expected minimum coverage ($(limit coverage).00%)"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

# Coverage gate (roadmap stage 3 T1): main holds the project with scripts/coverage-gate.sh (bootstrap copies it); the
# change adds app/models/cov.rb and its spec. The real rspec hook writes coverage/coverage.xml through the template
# .simplecov (simplecov-cobertura), then the template hook coverage-gate judges the changed lines: (101 + K) / 200.
gate_base() { # dir
    mkdir -p "$1/scripts"
    cp "$REPO_ROOT/common/testing-templates/coverage-gate.sh" "$1/scripts/"
    printf 'coverage/\n.cache/\n' > "$1/.gitignore"
    git -C "$1" add -A && git -C "$1" -c user.email=t@t -c user.name=t commit -qm base
    git -C "$1" update-ref refs/remotes/origin/main HEAD
}
w_gate_edge() { gate_base "$1"; w_cov_edge "$1"; }
w_gate_over() { gate_base "$1"; w_cov_over "$1"; }
hook_rspec_gate() {
    hook_rspec "$1" >/dev/null   # below the total minimum the hook fails — SimpleCov still writes the reports first
    [ -f "$1/coverage/coverage.xml" ] || { echo "the rspec hook wrote no coverage/coverage.xml"; return 1; }
    hook_rc "$1" coverage-gate pre-push
}

@test "ruby: 커버리지 게이트 — rspec 훅이 쓴 Cobertura 로 coverage-gate 훅이 바뀐 줄 한도(정본)%는 통과, 미만은 막는다" {
    require_ruby
    command -v uvx >/dev/null 2>&1 || require_tool pipx
    run rb_check hook_rspec_gate w_gate_edge w_gate_over "FAIL: changed-line coverage is below $(limit coverage)%"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "ruby: 한도 숫자가 정본과 같고 Metrics 규칙이 켜져 있고, 훅이 bundle exec 로 위반을 실패로 연결한다" {
    local y="$RB_TPL/.rubocop.yml" c="$RB_TPL/.pre-commit-config.yaml" r
    yq -e '[to_entries[] | select(.key | test("^Metrics/")) | select(.value.Enabled != true)] | length == 0' "$y" >/dev/null \
        || { echo "a Metrics/* cop in .rubocop.yml lacks Enabled: true"; return 1; }
    for r in "Metrics/CyclomaticComplexity|complexity" "Metrics/MethodLength|function_lines"; do
        R="${r%%|*}" yq -e '.[strenv(R)].Enabled == true' "$y" >/dev/null || { echo "${r%%|*} is not Enabled: true (omakase turns Metrics off)"; return 1; }
        [ "$(R="${r%%|*}" yq -r '.[strenv(R)].Max' "$y")" = "$(limit "${r#*|}")" ] || { echo "${r%%|*} Max is not $(limit "${r#*|}")"; return 1; }
    done
    grep -Eq "^  minimum_coverage $(limit coverage)\$" "$RB_TPL/.simplecov" || { echo ".simplecov minimum_coverage is not $(limit coverage)"; return 1; }
    [ "$(yq -r '.repos[].hooks[] | select(.id == "rubocop") | .entry' "$c")" = "bundle exec rubocop --autocorrect --fail-fast --force-exclusion" ] \
        || { echo "rubocop hook is not bundle exec rubocop"; return 1; }
    yq -r '.repos[].hooks[] | select(.id == "file-size-limit") | .entry' "$c" | grep -Fq -- "-gt $(limit file_lines) ]" \
        || { echo "file-size-limit hook limit is not $(limit file_lines)"; return 1; }
}

@test "ruby: 장부 — 복잡도·메서드·커버리지 ✓, 파일 script" {
    local m c
    for m in complexity function_lines coverage; do
        c="$(M="$m" yq -r '.languages.ruby[strenv(M)].cell' "$THRESHOLDS")"
        [ "$c" = "✓" ] || { echo "ruby.$m cell is [$c], expected ✓"; return 1; }
    done
    [ "$(yq -r '.languages.ruby.file_lines.cell' "$THRESHOLDS")" = "script" ] || { echo "ruby.file_lines cell is not script"; return 1; }
}

# A copy of the templates with one edit applied; prints the copy's path.
broken_tpl() { # file sed-expression
    local dir
    dir="$(mktemp -d -p "$BATS_TEST_TMPDIR")"
    cp -a "$RB_TPL/." "$dir/"
    sed_i -e "$2" "$dir/$1"
    ! cmp -s "$RB_TPL/$1" "$dir/$1" || { echo "broken variant did not change $1: $2" >&2; return 1; }
    echo "$dir"
}

@test "ruby: 반증 — 고장 난 설정 5종(Enabled 제거 2 · Max +1 2 · minimum_coverage -1)에서는 위 검사가 실패한다" {
    require_ruby
    local v file sed_expr runner w c l k
    c="$(limit complexity)"; l="$(limit function_lines)"; k="$(limit coverage)"
    # complexity needs both cops off: Metrics/PerceivedComplexity (Max 15) is a second guard on the same fixture
    for v in ".rubocop.yml|/^Metrics\/[CP][ye][cr][a-z]*Complexity:/,/Max/{/Enabled: true/d;}|hook_rubocop|w_complexity_edge w_complexity_over" \
             ".rubocop.yml|/^Metrics\/MethodLength:/,/Max/{/Enabled: true/d;}|hook_rubocop|w_lines_edge w_lines_over" \
             ".rubocop.yml|/^Metrics\/[CP][ye][cr][a-z]*Complexity:/,/Max/{s/Max: $c /Max: $(( c + 1 )) /;s/Max: $c\$/Max: $(( c + 1 ))/;}|hook_rubocop|w_complexity_edge w_complexity_over" \
             ".rubocop.yml|/^Metrics\/MethodLength:/,/Max/s/Max: $l /Max: $(( l + 1 )) /|hook_rubocop|w_lines_edge w_lines_over" \
             ".simplecov|s/^  minimum_coverage $k\$/  minimum_coverage $(( k - 1 ))/|hook_rspec|w_cov_edge w_cov_over"; do
        IFS='|' read -r file sed_expr runner w <<< "$v"
        RB_TPL="$(broken_tpl "$file" "$sed_expr")" || return 1
        # shellcheck disable=SC2086 # w holds two writer names
        run rb_check "$runner" $w "_"
        [ "$status" -ne 0 ] && grep -qF "over accepted" <<< "$output" \
            || { echo "check not broken the expected way (over accepted) by: $file $sed_expr — $output"; return 1; }
        RB_TPL="$REPO_ROOT/ruby-rails/templates"
    done
}
