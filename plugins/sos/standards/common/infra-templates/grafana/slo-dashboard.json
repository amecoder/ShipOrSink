{
  "__comment": "Grafana > Import > Upload JSON 으로 사용. Prometheus 데이터소스 필요. 서비스명/네임스페이스/간격 변수를 선택하면 4 Golden Signals + SLO 상태를 한눈에 확인할 수 있다.",
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus 데이터소스",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" }
  ],
  "id": null,
  "uid": "slo-golden-signals",
  "title": "SLO Dashboard - 4 Golden Signals",
  "description": "4 Golden Signals (Latency, Traffic, Errors, Saturation) + SLO 달성률 / Error Budget 잔여량 모니터링",
  "tags": ["slo", "golden-signals", "sre", "dev-standards"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "style": "dark",

  "templating": {
    "list": [
      {
        "name": "service",
        "label": "서비스",
        "description": "모니터링 대상 서비스 이름",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(http_requests_total, service)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {}
      },
      {
        "name": "namespace",
        "label": "네임스페이스",
        "description": "Kubernetes 네임스페이스",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(http_requests_total{service=\"$service\"}, namespace)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "sort": 1,
        "current": {}
      },
      {
        "name": "interval",
        "label": "집계 간격",
        "description": "PromQL rate() 윈도우 크기",
        "type": "interval",
        "query": "1m,5m,10m,15m,30m,1h",
        "current": { "text": "5m", "value": "5m" },
        "auto": false
      },
      {
        "name": "slo_target",
        "label": "SLO 목표(%)",
        "description": "가용성 SLO 목표값 (예: 99.95)",
        "type": "constant",
        "query": "99.95",
        "current": { "text": "99.95", "value": "99.95" }
      },
      {
        "name": "slo_window",
        "label": "SLO 윈도우",
        "description": "Error Budget 계산 기간",
        "type": "constant",
        "query": "30d",
        "current": { "text": "30d", "value": "30d" }
      }
    ]
  },

  "annotations": {
    "list": [
      {
        "name": "배포 이벤트",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "enable": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "expr": "changes(kube_deployment_status_observed_generation{namespace=~\"$namespace\"}[1m]) > 0",
        "titleFormat": "배포 감지",
        "tagKeys": "namespace,deployment"
      }
    ]
  },

  "panels": [
    {
      "__comment_row": "========== Row 1: SLO 상태 개요 ==========",
      "type": "row",
      "title": "SLO 상태 개요",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1
    },
    {
      "__comment": "현재 가용성 — SLO 달성 여부를 한눈에 확인하는 Stat 패널",
      "type": "stat",
      "title": "현재 가용성 (Availability)",
      "description": "전체 요청 중 성공 응답 비율. SLO 목표: ${slo_target}%",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 10,
      "targets": [
        {
          "expr": "(\n  1 - (\n    sum(rate(http_requests_total{service=\"$service\", namespace=~\"$namespace\", status_code=~\"5..\"}[$interval]))\n    /\n    sum(rate(http_requests_total{service=\"$service\", namespace=~\"$namespace\"}[$interval]))\n  )\n) * 100",
          "legendFormat": "가용성 %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 99.5 },
              { "color": "yellow", "value": 99.9 },
              { "color": "green", "value": 99.95 }
            ]
          },
          "mappings": []
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "__comment": "SLO 달성률 — Rolling Window 기간 내 SLO 목표 대비 현재 상태",
      "type": "gauge",
      "title": "SLO 달성률 (Rolling ${slo_window})",
      "description": "SLO 윈도우 기간 내 가용성 / SLO 목표. 100% = 정확히 목표 달성, >100% = 여유 있음",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 11,
      "targets": [
        {
          "expr": "(\n  (\n    1 - (\n      sum(increase(http_requests_total{service=\"$service\", namespace=~\"$namespace\", status_code=~\"5..\"}[$slo_window]))\n      /\n      sum(increase(http_requests_total{service=\"$service\", namespace=~\"$namespace\"}[$slo_window]))\n    )\n  ) * 100\n  / $slo_target\n) * 100",
          "legendFormat": "달성률",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 95,
          "max": 105,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 98 },
              { "color": "yellow", "value": 99 },
              { "color": "green", "value": 100 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "__comment": "Error Budget 잔여량 — 남은 허용 장애 시간(분)",
      "type": "stat",
      "title": "Error Budget 잔여 (분)",
      "description": "SLO 윈도우 내 남은 허용 장애 시간. 0 이하 = Error Budget 소진",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "id": 12,
      "targets": [
        {
          "expr": "(\n  (1 - $slo_target / 100) * 30 * 24 * 60\n  -\n  (\n    sum(increase(http_requests_total{service=\"$service\", namespace=~\"$namespace\", status_code=~\"5..\"}[$slo_window]))\n    /\n    sum(increase(http_requests_total{service=\"$service\", namespace=~\"$namespace\"}[$slo_window]))\n  ) * 30 * 24 * 60\n)",
          "legendFormat": "잔여 (분)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "min",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 15 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "__comment": "Error Budget 소진률 — 퍼센트로 표시 (100% = 완전 소진)",
      "type": "gauge",
      "title": "Error Budget 소진률 (%)",
      "description": "Error Budget 소진 비율. 100% 도달 시 배포 동결 고려",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "id": 13,
      "targets": [
        {
          "expr": "(\n  sum(increase(http_requests_total{service=\"$service\", namespace=~\"$namespace\", status_code=~\"5..\"}[$slo_window]))\n  /\n  sum(increase(http_requests_total{service=\"$service\", namespace=~\"$namespace\"}[$slo_window]))\n)\n/\n(1 - $slo_target / 100)\n* 100",
          "legendFormat": "소진률",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },

    {
      "__comment_row": "========== Row 2: Latency (레이턴시) ==========",
      "type": "row",
      "title": "1. Latency (레이턴시)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 2
    },
    {
      "__comment": "Latency P50/P95/P99 — 응답 시간 분위수 추이",
      "type": "timeseries",
      "title": "응답 시간 분위수 (P50 / P95 / P99)",
      "description": "성공 응답(2xx)의 레이턴시 분포. P95 < 500ms, P99 < 1s 권장",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 7 },
      "id": 20,
      "targets": [
        {
          "expr": "histogram_quantile(0.50,\n  sum(rate(http_request_duration_seconds_bucket{service=\"$service\", namespace=~\"$namespace\"}[$interval])) by (le)\n)",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95,\n  sum(rate(http_request_duration_seconds_bucket{service=\"$service\", namespace=~\"$namespace\"}[$interval])) by (le)\n)",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99,\n  sum(rate(http_request_duration_seconds_bucket{service=\"$service\", namespace=~\"$namespace\"}[$interval])) by (le)\n)",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1.0 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "P50" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "P95" },
            "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "P99" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] }
      }
    },
    {
      "__comment": "Latency 현재값 — P50, P95, P99 현재 스냅샷",
      "type": "stat",
      "title": "현재 레이턴시",
      "description": "P50/P95/P99 현재값 요약",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 7 },
      "id": 21,
      "targets": [
        {
          "expr": "histogram_quantile(0.50,\n  sum(rate(http_request_duration_seconds_bucket{service=\"$service\", namespace=~\"$namespace\"}[$interval])) by (le)\n)",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95,\n  sum(rate(http_request_duration_seconds_bucket{service=\"$service\", namespace=~\"$namespace\"}[$interval])) by (le)\n)",
          "legendFormat": "P95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99,\n  sum(rate(http_request_duration_seconds_bucket{service=\"$service\", namespace=~\"$namespace\"}[$interval])) by (le)\n)",
          "legendFormat": "P99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 0.8 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },

    {
      "__comment_row": "========== Row 3: Traffic (트래픽) ==========",
      "type": "row",
      "title": "2. Traffic (트래픽)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 3
    },
    {
      "__comment": "Traffic RPS 추이 — 초당 요청 수 시계열",
      "type": "timeseries",
      "title": "초당 요청 수 (RPS)",
      "description": "서비스로 들어오는 전체 요청 수. 급격한 변화는 트래픽 이상 징후",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 30,
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"$service\", namespace=~\"$namespace\"}[$interval]))",
          "legendFormat": "전체 RPS",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_requests_total{service=\"$service\", namespace=~\"$namespace\", status_code=~\"2..\"}[$interval]))",
          "legendFormat": "성공 (2xx)",
          "refId": "B"
        },
        {
          "expr": "sum(rate(http_requests_total{service=\"$service\", namespace=~\"$namespace\", status_code=~\"4..\"}[$interval]))",
          "legendFormat": "클라이언트 에러 (4xx)",
          "refId": "C"
        },
        {
          "expr": "sum(rate(http_requests_total{service=\"$service\", namespace=~\"$namespace\", status_code=~\"5..\"}[$interval]))",
          "legendFormat": "서버 에러 (5xx)",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2,
            "stacking": { "mode": "none" },
            "showPoints": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "성공 (2xx)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "클라이언트 에러 (4xx)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "서버 에러 (5xx)" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] }
      }
    },
    {
      "__comment": "Traffic by Route — 엔드포인트별 RPS 분포",
      "type": "timeseries",
      "title": "엔드포인트별 RPS (Top 10)",
      "description": "트래픽이 많은 상위 10개 엔드포인트. 핫스팟 식별용",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 31,
      "targets": [
        {
          "expr": "topk(10,\n  sum(rate(http_requests_total{service=\"$service\", namespace=~\"$namespace\"}[$interval])) by (method, route)\n)",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 5,
            "lineWidth": 1,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean"] }
      }
    },

    {
      "__comment_row": "========== Row 4: Error Rate (에러율) ==========",
      "type": "row",
      "title": "3. Error Rate (에러율)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 4
    },
    {
      "__comment": "Error Rate 추이 — 5xx 에러 비율 시계열 (SLO 임계값 표시)",
      "type": "timeseries",
      "title": "에러율 추이 (5xx / 전체)",
      "description": "서버 에러 비율. SLO 위반 임계값(빨간 점선) 초과 시 대응 필요",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "id": 40,
      "targets": [
        {
          "expr": "(\n  sum(rate(http_requests_total{service=\"$service\", namespace=~\"$namespace\", status_code=~\"5..\"}[$interval]))\n  /\n  sum(rate(http_requests_total{service=\"$service\", namespace=~\"$namespace\"}[$interval]))\n) * 100",
          "legendFormat": "에러율 %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "lineWidth": 2,
            "showPoints": "auto",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] }
      }
    },
    {
      "__comment": "에러율 by Route — 엔드포인트별 에러율 분포",
      "type": "bargauge",
      "title": "엔드포인트별 에러율 (Top 10)",
      "description": "에러율이 높은 상위 10개 엔드포인트. 개별 엔드포인트 품질 점검용",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "id": 41,
      "targets": [
        {
          "expr": "topk(10,\n  (\n    sum(rate(http_requests_total{service=\"$service\", namespace=~\"$namespace\", status_code=~\"5..\"}[$interval])) by (method, route)\n    /\n    sum(rate(http_requests_total{service=\"$service\", namespace=~\"$namespace\"}[$interval])) by (method, route)\n  ) * 100\n)",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "orange", "value": 1.0 },
              { "color": "red", "value": 5.0 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },

    {
      "__comment_row": "========== Row 5: Saturation (포화도) ==========",
      "type": "row",
      "title": "4. Saturation (포화도)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 },
      "id": 5
    },
    {
      "__comment": "CPU 사용률 — Pod별 CPU 사용량 추이",
      "type": "timeseries",
      "title": "CPU 사용률",
      "description": "Pod별 CPU 사용률. 80% 이상 지속 시 스케일 아웃 고려",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 34 },
      "id": 50,
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", pod=~\"$service.*\"}[$interval])) by (pod)\n/\nsum(kube_pod_container_resource_limits{namespace=~\"$namespace\", pod=~\"$service.*\", resource=\"cpu\"}) by (pod)\n* 100",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "__comment": "메모리 사용률 — Pod별 메모리 사용량 추이",
      "type": "timeseries",
      "title": "메모리 사용률",
      "description": "Pod별 메모리 사용률. 80% 이상 지속 시 OOM 위험",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 34 },
      "id": 51,
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=~\"$namespace\", pod=~\"$service.*\"}) by (pod)\n/\nsum(kube_pod_container_resource_limits{namespace=~\"$namespace\", pod=~\"$service.*\", resource=\"memory\"}) by (pod)\n* 100",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "__comment": "네트워크/디스크 포화도 — 기타 리소스 사용 지표",
      "type": "timeseries",
      "title": "네트워크 수신/송신 (Bytes/s)",
      "description": "Pod별 네트워크 트래픽. 대역폭 한계 도달 여부 확인용",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 34 },
      "id": 52,
      "targets": [
        {
          "expr": "sum(rate(container_network_receive_bytes_total{namespace=~\"$namespace\", pod=~\"$service.*\"}[$interval])) by (pod)",
          "legendFormat": "수신: {{pod}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(container_network_transmit_bytes_total{namespace=~\"$namespace\", pod=~\"$service.*\"}[$interval])) by (pod)",
          "legendFormat": "송신: {{pod}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },

    {
      "__comment_row": "========== Row 6: Error Budget 번다운 ==========",
      "type": "row",
      "title": "Error Budget 번다운",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
      "id": 6
    },
    {
      "__comment": "Error Budget 번다운 차트 — 시간에 따른 Error Budget 잔여량 추이",
      "type": "timeseries",
      "title": "Error Budget 번다운 차트 (Rolling ${slo_window})",
      "description": "Error Budget 잔여 비율 추이. 0%에 도달하면 배포 동결, 안정화 작업에 집중",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 43 },
      "id": 60,
      "targets": [
        {
          "expr": "(\n  1 - (\n    sum(increase(http_requests_total{service=\"$service\", namespace=~\"$namespace\", status_code=~\"5..\"}[$slo_window]))\n    /\n    sum(increase(http_requests_total{service=\"$service\", namespace=~\"$namespace\"}[$slo_window]))\n  )\n  /\n  (1 - $slo_target / 100)\n) * 100",
          "legendFormat": "Error Budget 잔여 %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 25,
            "lineWidth": 2,
            "showPoints": "never",
            "gradientMode": "scheme",
            "thresholdsStyle": { "mode": "area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 25 },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 75 }
            ]
          },
          "color": { "mode": "thresholds" }
        }
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "min"] }
      }
    }
  ]
}
