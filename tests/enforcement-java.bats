#!/usr/bin/env bats
# tests/enforcement-java.bats — Java 템플릿의 크기 수치가 실제로 막히는지 실행 결과로 판정 (로드맵 3단계).
# tests/enforcement.bats 와 같은 방식: edge(한도 = 통과) · over(한도 + 1 = 실패) fixture 를 만들고
# 배포 템플릿 java-spring/templates/checkstyle.xml 을 그대로 checkstyle 에 넘긴다.
#   복잡도 · 메서드 길이 · 파일 길이 — checkstyle CyclomaticComplexity · MethodLength · FileLength (✓)
#   커버리지 — JaCoCo 규칙은 Gradle 안에 있고 Java CI 템플릿이 없다 → 로드맵 3단계 A7(diff-cover) 에서
# Gradle checkstyle 플러그인은 toolVersion 의 checkstyle 에 같은 설정 파일을 넘긴다 — 여기서는 그 버전의 단독
# 실행 jar(checkstyle-<toolVersion>-all.jar)를 쓴다. CI 는 ci.yml 이 핀·sha256 으로 받아 CHECKSTYLE_JAR 로 넘긴다.
# 로컬: ~/.cache/dev-standards-tools/checkstyle-<toolVersion>-all.jar (GitHub 릴리스 checkstyle/checkstyle)

load helpers

THRESHOLDS="$REPO_ROOT/common/quality-thresholds.yaml"
JAVA_TPL="$REPO_ROOT/java-spring/templates"

setup() {
    require_tool yq
}

limit() { # metric
    M="$1" yq -r '.languages.java[strenv(M)].limit // .thresholds[strenv(M)]' "$THRESHOLDS"
}

# The checkstyle version the Gradle template runs — toolVersion inside the `checkstyle { … }` block only
# (jacoco and spotbugs blocks have their own toolVersion).
tool_version() {
    sed -n '/^checkstyle {/,/^}/p' "$REPO_ROOT/java-spring/templates/quality.gradle.kts" \
        | sed -nE 's/^[[:space:]]*toolVersion = "([0-9.]+)"$/\1/p'
}

checkstyle_jar() {
    echo "${CHECKSTYLE_JAR:-$HOME/.cache/dev-standards-tools/checkstyle-$(tool_version)-all.jar}"
}

# Like require_tool, for the jar: skip locally, fail in CI (TEMPLATE_TOOLS_REQUIRED=1).
require_checkstyle() {
    [ -n "$(tool_version)" ] || { echo "checkstyle toolVersion not found in quality.gradle.kts" >&2; return 1; }
    require_tool java
    [ -f "$(checkstyle_jar)" ] && return 0
    if [ "${TEMPLATE_TOOLS_REQUIRED:-0}" = "1" ]; then
        echo "required tool missing: $(checkstyle_jar)" >&2
        return 1
    fi
    skip "checkstyle jar not found: $(checkstyle_jar)"
}

# Runs the template checkstyle.xml (whole config — every module) on the fixture's sources.
cs_run() { # dir
    (cd "$1" && java -jar "$(checkstyle_jar)" -c "$JAVA_TPL/checkstyle.xml" src/main/java 2>&1)
}

cs_dir() {
    local dir
    dir="$(mktemp -d -p "$BATS_TEST_TMPDIR")"
    mkdir -p "$dir/src/main/java/fx"
    echo "$dir"
}

# A Google-style clean final class around the methods read from stdin.
java_class() { # dir
    { printf 'package fx;\n\n/** Generated by tests/enforcement-java.bats. */\npublic final class Fixture {\n'
      printf '  private Fixture() {}\n\n'
      cat
      printf '}\n'; } > "$1/src/main/java/fx/Fixture.java"
}

javadoc() {
    printf '  /**\n   * Adds.\n   *\n   * @param x input\n   * @return result\n   */\n'
}

# Cyclomatic complexity N as checkstyle counts it: 1 + one per `if`.
java_complexity_method() { # name N
    local i
    javadoc
    printf '  public static int %s(int x) {\n    int y = x;\n' "$1"
    for i in $(seq 1 $(( $2 - 1 ))); do printf '    if (y == %d) {\n      y += %d;\n    }\n' "$i" "$i"; done
    printf '    return y;\n  }\n'
}

# A method of N counted lines: the line holding the opening `{` through the closing `}`. The signature is
# wrapped so two of its lines come before the `{` line — they must not count (MethodLength starts at `{`),
# and one blank plus one comment-only line are added on top — countEmpty=false must not count them.
java_lines_method() { # name N
    local i
    printf '  /**\n   * Adds.\n   *\n   * @param x input\n   * @param z other\n   * @return result\n   */\n'
    printf '  public static int %s(\n      int x,\n      int z) {\n    int y = x + z;\n\n    // not counted\n' "$1"
    for i in $(seq 1 $(( $2 - 4 ))); do printf '    y += %d;\n' "$i"; done
    printf '    return y;\n  }\n'
}

# A file of N physical lines (comment padding — no other module reacts to it).
java_file_n() { # dir N
    local i
    { printf 'package fx;\n\n/** Generated by tests/enforcement-java.bats. */\npublic final class Fixture {\n'
      printf '  private Fixture() {}\n'
      for i in $(seq 1 $(( $2 - 6 ))); do printf '  // line %d\n' "$i"; done
      printf '}\n'; } > "$1/src/main/java/fx/Fixture.java"
}

w_complexity_edge() { java_complexity_method edge "$(limit complexity)" | java_class "$1"; }
w_complexity_over() { java_complexity_method over $(( $(limit complexity) + 1 )) | java_class "$1"; }
w_lines_edge() { java_lines_method edge "$(limit function_lines)" | java_class "$1"; }
w_lines_over() { java_lines_method over $(( $(limit function_lines) + 1 )) | java_class "$1"; }
w_file_edge() { java_file_n "$1" "$(limit file_lines)"; }
w_file_over() { java_file_n "$1" $(( $(limit file_lines) + 1 )); }

# edge must pass the whole config (exit 0); over must fail and print the expected marker.
cs_check() { # edge-writer over-writer expected-over-message
    local e o out rc
    e="$(cs_dir)"; o="$(cs_dir)"
    "$1" "$e"; "$2" "$o"
    out="$(cs_run "$e")" || { echo "edge rejected: $out"; return 1; }
    rc=0; out="$(cs_run "$o")" || rc=$?
    [ "$rc" -ne 0 ] || { echo "over accepted (exit 0): $out"; return 1; }
    grep -qF -- "$3" <<< "$out" || { echo "over: expected [$3] in: $out"; return 1; }
}

@test "java: 복잡도 — 순환 복잡도 한도(정본) 메서드는 통과, 한도+1 은 템플릿 checkstyle 이 막는다" {
    require_checkstyle
    run cs_check w_complexity_edge w_complexity_over \
        "Cyclomatic Complexity is $(( $(limit complexity) + 1 )) (max allowed is $(limit complexity))"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "java: 메서드 길이 — { 줄부터 한도(정본) 줄은 시그니처 앞줄·빈 줄·주석 줄이 더 있어도 통과, 한도+1 줄은 템플릿 checkstyle 이 막는다" {
    require_checkstyle
    run cs_check w_lines_edge w_lines_over \
        "Method over length is $(( $(limit function_lines) + 1 )) lines (max allowed is $(limit function_lines))"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "java: 파일 길이 — 한도(정본) 줄 파일은 통과, 한도+1 줄은 템플릿 checkstyle 이 막는다" {
    require_checkstyle
    run cs_check w_file_edge w_file_over \
        "File length is $(( $(limit file_lines) + 1 )) lines (max allowed is $(limit file_lines))"
    [ "$status" -eq 0 ] || { echo "$output"; return 1; }
}

@test "java: 검사에 쓴 jar 가 템플릿 toolVersion 과 같은 버전이고, CI 핀도 그 버전이다" {
    require_checkstyle
    local v
    v="$(tool_version)"
    [ -n "$v" ] || { echo "toolVersion not found in quality.gradle.kts"; return 1; }
    java -jar "$(checkstyle_jar)" --version | grep -qxF "Checkstyle version: $v" \
        || { echo "jar is not checkstyle $v: $(java -jar "$(checkstyle_jar)" --version)"; return 1; }
    yq -r '.env.CHECKSTYLE_VERSION' "$PROJECT_ROOT/.github/workflows/ci.yml" | grep -qxF "$v" \
        || { echo "ci.yml CHECKSTYLE_VERSION is not the template toolVersion $v"; return 1; }
}

@test "java: checkstyle.xml 의 한도 숫자가 정본과 같고, Gradle 이 위반을 실패로 연결한다" {
    local x="$JAVA_TPL/checkstyle.xml" g="$JAVA_TPL/quality.gradle.kts" m pat
    for m in "CyclomaticComplexity|complexity" "MethodLength|function_lines" "FileLength|file_lines"; do
        pat="<module name=\"${m%%|*}\">"
        grep -A1 -F "$pat" "$x" | grep -qF "<property name=\"max\" value=\"$(limit "${m#*|}")\"/>" \
            || { echo "${m%%|*} max is not $(limit "${m#*|}")"; return 1; }
    done
    # checkstyle's exit code counts errors only — the root (Checker) severity must stay error.
    # The template sets severity once, on the root; a per-module severity would need its own check.
    grep -qF '<property name="severity" value="error"/>' "$x" || { echo "root severity is not error"; return 1; }
    for pat in 'configFile = file("${rootDir}/checkstyle.xml")' 'maxErrors = 0' 'maxWarnings = 0' 'isIgnoreFailures = false'; do
        grep -qF -- "$pat" "$g" || { echo "quality.gradle.kts lost: $pat"; return 1; }
    done
    sed -n '/^tasks.check {/,/^}/p' "$g" | grep -qF '"checkstyleMain"' \
        || { echo "tasks.check does not depend on checkstyleMain"; return 1; }
}

@test "java: 장부 — 크기 3칸은 ✓, 커버리지는 script(coverage-gate)" {
    local m c
    for m in complexity function_lines file_lines; do
        c="$(M="$m" yq -r '.languages.java[strenv(M)].cell' "$THRESHOLDS")"
        [ "$c" = "✓" ] || { echo "java.$m cell is [$c], expected ✓"; return 1; }
    done
    c="$(yq -r '.languages.java.coverage.cell' "$THRESHOLDS")"
    [ "$c" = "script" ] || { echo "java.coverage cell is [$c], expected script"; return 1; }
}

# A copy of checkstyle.xml with one edit applied; prints the copy's directory.
broken_tpl() { # sed-expression
    local dir
    dir="$(mktemp -d -p "$BATS_TEST_TMPDIR")"
    cp "$JAVA_TPL/checkstyle.xml" "$dir/"
    sed_i -e "$1" "$dir/checkstyle.xml"
    ! cmp -s "$JAVA_TPL/checkstyle.xml" "$dir/checkstyle.xml" || { echo "broken variant did not change checkstyle.xml: $1" >&2; return 1; }
    echo "$dir"
}

@test "java: 반증 — 고장 난 설정 4종(한도 +1 3 · 빈 줄 세기 1)에서는 위 검사가 실패한다" {
    require_checkstyle
    local v w why
    for v in "/CyclomaticComplexity/,/max/s/value=\"15\"/value=\"16\"/|w_complexity_edge w_complexity_over|over accepted" \
             "/MethodLength/,/max/s/value=\"50\"/value=\"51\"/|w_lines_edge w_lines_over|over accepted" \
             "/FileLength/,/max/s/value=\"800\"/value=\"801\"/|w_file_edge w_file_over|over accepted" \
             "s/name=\"countEmpty\" value=\"false\"/name=\"countEmpty\" value=\"true\"/|w_lines_edge w_lines_over|edge rejected"; do
        IFS='|' read -r sed_expr w why <<< "$v"
        JAVA_TPL="$(broken_tpl "$sed_expr")" || return 1
        # shellcheck disable=SC2086 # w holds two writer names
        run cs_check $w "length"
        [ "$status" -ne 0 ] && grep -qF "$why" <<< "$output" \
            || { echo "check not broken the expected way ($why) by: $sed_expr — $output"; return 1; }
        JAVA_TPL="$REPO_ROOT/java-spring/templates"
    done
}
